---
import { getProductVisual } from "../product-images.mjs";
import { polyMailerThicknessOptions } from "../product-data.mjs";
import packingSource from "../assets/new-products/poly-mailers-apparel-packing.jpg";
import productionSource from "../assets/new-products/poly-mailers-production.jpg";
import diagramSource from "../assets/new-products/poly-mailers-customization-diagram.png";

const [packing, production, diagram] = await Promise.all([
  getProductVisual(packingSource), getProductVisual(productionSource), getProductVisual(diagramSource)
]);
const methods = [
  ["Screen printing — our main method", "Simple one- or two-color vector logos and text", "Confirm artwork detail, print colors, placement and coverage."],
  ["Gravure printing", "All-over patterns, multicolor illustrations and gradients", "Review the proposed process, setup and quantity for the design."],
  ["Flexographic printing", "Solid color blocks and text", "Confirm compatibility with the selected film and required appearance."],
  ["Digital printing", "Complex full-color or photographic designs, and multiple SKUs", "Confirm material compatibility, quantities per design and the offered sample route."]
];
const photos = [
  { visual: packing, alt: "Pink strawberry-pattern poly mailer being packed with folded clothing", caption: "Packing photograph from this anonymous apparel project, supplied by Welltroy. The folded garment and inner wrapping are shown together with the printed outer mailer." },
  { visual: production, alt: "Printed pink poly mailers stacked beside bag-making equipment in a production area", caption: "Production photograph from the same project, supplied by Welltroy. The visible equipment and bag stacks do not identify the printing process used." }
];
---
<section class="section" id="poly-mailer-thickness" aria-labelledby="poly-thickness-heading">
  <div class="container">
    <p class="eyebrow">Film specification</p>
    <h2 id="poly-thickness-heading">Single-Wall Film Thickness Options</h2>
    <p class="lead">Reference options are 60, 70, 80, 90 and 100 microns per side. Specify the thickness of one film wall; the front and back panels are not added together. Confirm the offered option for your size, artwork and order quantity.</p>
    <p class="table-scroll-hint">Swipe the table horizontally to compare thickness units.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Poly mailer single-wall thickness conversion">
      <table><caption class="sr-only">Five reference film thickness options, all measured per side</caption><thead><tr><th scope="col">Microns per side</th><th scope="col">Millimeters per side</th><th scope="col">Approx. mil per side</th></tr></thead><tbody>{polyMailerThicknessOptions.map(option => <tr><th scope="row">{option.microns} μm</th><td>{option.millimeters} mm</td><td>{option.mil} mil</td></tr>)}</tbody></table>
    </div>
    <p><strong>Keep the units clear:</strong> 1 mil is 0.001 inch, or 25.4 microns; it is a different unit from millimeter. For example, 60 μm per side is 0.06 mm per side, approximately 2.36 mil per side.</p>
    <p class="muted">These values are specification references, not an inspection tolerance or a load rating. Confirm film material, the thickness measurement method and agreed tolerance in your quotation. Check the chosen bag with the actual contents and keep the <a href="/guides/custom-mailer-sample-approval/">approved sample record</a>.</p>
  </div>
</section>
<section class="section section-soft" id="poly-mailer-printing" aria-labelledby="poly-printing-heading">
  <div class="container">
    <p class="eyebrow">Custom printing</p>
    <h2 id="poly-printing-heading">Logo Shipping Bags: Artwork &amp; Printing Options</h2>
    <p class="lead">Need shipping bags with your logo? For clothing and other soft, non-fragile goods, start with a poly mailer, then specify the bag size, film, print sides and quantity for each design. A logo-only print and an all-over pattern may need different production routes.</p>
    <div class="logo-brief" id="logo-quote-brief">
      <h3>Prepare One Brief for Each Size &amp; Design</h3>
      <p><a class="text-link" href="/downloads/poly-mailer-logo-quote-brief.txt" download>Download the editable logo mailer quote brief (.txt) →</a> Fill it in, then paste it into your enquiry or attach it with the artwork.</p>
      <ul>
        <li><strong>Bag and contents:</strong> catalogue model or target usable size, packed item dimensions and weight.</li>
        <li><strong>Film and appearance:</strong> material, single-wall thickness, bag color, and finish preference.</li>
        <li><strong>Artwork:</strong> front/back print, logo dimensions, placement, colors and editable file where available.</li>
        <li><strong>Order and sample:</strong> quantity per size, color and design, destination, sample type and desired delivery date.</li>
      </ul>
      <p><strong>Example enquiry, not a confirmed configuration:</strong> P03 outer size 25 × 30 + 5 cm; 500 bags of one size and design; one-color logo on the front; folded clothing; delivery to the United States. Add the packed dimensions, weight, film preference and artwork so we can confirm fit, print area, minimum quantity and pricing.</p>
      <p>We provide a free initial design draft within 24 hours after a clear brief. Confirm the offered specification and sample route before approval; the initial draft is not the final production proof.</p>
      <div class="button-row"><a class="button" href="/quote/?product=poly-mailers#quote-form" data-quote-placement="product-details">Send My Logo Mailer Brief</a><a class="text-link" href="/guides/logo-artwork-checklist/">Check artwork files &amp; proof approval →</a></div>
    </div>
    <h3>Screen Printing &amp; Other Artwork Options</h3>
    <p class="lead">Screen printing is our main method for custom poly mailers. For simple one- or two-color vector logos and text, it is the starting point for review. We select the final printing method around your design, film, coverage, order quantity and sample requirements.</p>
    <p>Use the options below to prepare your enquiry. The offered process, setup charges, minimum quantity and proof are confirmed for each order; the 500-piece starting quantity does not automatically apply to every printing method.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Poly mailer printing method selection">
      <table>
        <caption class="sr-only">Printing methods to discuss for your custom poly mailer artwork</caption>
        <thead><tr><th scope="col">Printing method</th><th scope="col">Artwork to discuss</th><th scope="col">Before approval</th></tr></thead>
        <tbody>{methods.map(([method, artwork, check]) => <tr><th scope="row">{method}</th><td>{artwork}</td><td>{check}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="muted">The printing method does not establish whether a bag is biodegradable or recyclable. Any material or environmental requirement needs confirmation for the selected construction.</p>
    <div class="poly-print-layout">
      <div>
        <h3>Confirm the Print Area, Body &amp; Flap</h3>
        <p>Send front and back artwork separately and identify the bag width, body length and flap length. Confirm usable inner dimensions separately from outer dimensions.</p>
        <ul>
          <li>Mark logo placement, print sides, colors and intended coverage.</li>
          <li>Agree printable boundaries and clearance from seams and the sealing zone.</li>
          <li>Confirm the adhesive strip and flap configuration on the production proof.</li>
          <li>Choose a <a href="#poly-mailer-thickness">single-wall thickness reference</a>, then confirm material, measurement method and tolerance with your quotation.</li>
        </ul>
        <p>The reference drawing shows the customization concept. It is not to scale and is not the approved dieline for your order.</p>
        <a class="text-link" href="/guides/logo-artwork-checklist/">Prepare your logo artwork →</a>
      </div>
      <figure>
        <a href={diagram.imageFull} target="_blank" rel="noopener" aria-label="View the poly mailer customization diagram">
          <img src={diagram.image} srcset={diagram.imageSrcSet} sizes="(max-width: 760px) calc(100vw - 40px), 570px" alt="Poly mailer reference drawing showing front and back print areas, width, body length and adhesive flap" width={diagram.imageWidth} height={diagram.imageHeight} loading="lazy" decoding="async" />
        </a>
        <figcaption>Customization reference supplied by Welltroy. Confirm measurement directions and print boundaries on the final proof.</figcaption>
      </figure>
    </div>
    <section class="poly-case" id="poly-mailer-case" aria-labelledby="poly-case-heading">
      <p class="eyebrow">Welltroy customer project · shared anonymously</p>
      <h3 id="poly-case-heading">Apparel Project: Strawberry-Print Poly Mailers</h3>
      <p class="muted">Case review updated <time datetime="2026-11-01">1 November 2026</time></p>
      <p class="lead">The pack pairs a pink strawberry-themed outer mailer with folded clothing and inner presentation materials. The supplied production and packing photographs document the same completed apparel project, shared anonymously.</p>
      <div class="poly-photo-grid">
      {photos.map(({visual, alt, caption}) => <figure>
        <a href={visual.imageFull} target="_blank" rel="noopener" aria-label={`View larger image: ${alt}`}>
          <img src={visual.image} srcset={visual.imageSrcSet} sizes="(max-width: 760px) calc(100vw - 40px), 570px" alt={alt} width={visual.imageWidth} height={visual.imageHeight} loading="lazy" decoding="async" />
        </a>
        <figcaption>{caption}</figcaption>
      </figure>)}
      </div>
      <div class="poly-case-grid">
        <div><h4>What Was Delivered and Shown</h4><dl class="poly-case-facts"><dt>Application</dt><dd>A printed outer shipping bag for folded clothing, shown with inner wrapping and garment inserts.</dd><dt>Appearance</dt><dd>A pink base with strawberry-themed artwork. The photographs provide visual references for the bag design and packing setup.</dd><dt>Production reference</dt><dd>Printed bags and film are shown beside bag-making equipment, with finished bags stacked for handling.</dd><dt>Packing reference</dt><dd>The folded garment is loaded into the outer mailer together with its inner presentation materials.</dd></dl></div>
        <div><h4>Planning a Similar Apparel Pack</h4><ol><li>Measure the folded garment with the inner bag, tissue, cards and any other inserts included.</li><li>Send your own artwork, print sides and intended coverage. Confirm the printing route for the selected film and design.</li><li>Check usable inner space, insertion and flap closure on a filled sample, then retain the agreed artwork and specification for reorders.</li></ol><p>Refer to the <strong>strawberry apparel project</strong> in your enquiry and include quantity per size and design, destination and target timing.</p></div>
      </div>
      <p class="muted">Case-specific bag dimensions, single-wall film thickness, order quantity and transit statistics are not published. The film options and catalogue sizes elsewhere on this page are separate references, rather than measurements assigned to these photographs.</p>
      <div class="button-row"><a class="button" href="/quote/?product=poly-mailers#quote-form" data-quote-placement="product-details">Plan My Printed Apparel Mailer</a><a class="text-link" href="/guides/mailer-size-for-clothing/#measurement-record">Record the complete clothing pack →</a></div>
    </section>
    <div class="button-row"><a class="button" href="/quote/?product=poly-mailers#quote-form" data-quote-placement="product-details">Discuss Your Artwork &amp; Printing</a></div>
  </div>
</section>
<style>
  #poly-mailer-printing,#poly-mailer-thickness,#logo-quote-brief,#poly-mailer-case {scroll-margin-top:100px;}
  .poly-case {margin:36px 0;padding:28px;background:var(--surface,#fff);border:1px solid var(--line,#d8e1db);border-radius:16px;min-width:0;}
  .poly-case h3 {font-size:1.6rem;margin-top:0;}.poly-case h4 {font-size:1.1rem;}
  .poly-case-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;}.poly-case-grid>div{min-width:0;}
  .poly-case-facts {display:grid;grid-template-columns:minmax(100px,.35fr) minmax(0,1fr);gap:14px 16px;}.poly-case-facts dt{font-weight:700;}.poly-case-facts dd{margin:0;min-width:0;}
  .logo-brief {padding:24px;border:1px solid var(--line, #d8e1db);border-radius:12px;background:var(--surface, #fff);margin:28px 0;}
  .logo-brief li {margin-bottom:10px;}
  .poly-print-layout,.poly-photo-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;margin:32px 0;align-items:start;}
  figure {margin:0;min-width:0;}
  figure a {display:block;}
  figure img {display:block;width:100%;height:auto;border-radius:12px;}
  figcaption {font-size:.82rem;line-height:1.5;color:var(--muted);margin-top:10px;}
  th,td {vertical-align:top;}
  @media(max-width:760px) {
    .poly-case {padding:18px;}.poly-case-grid {grid-template-columns:minmax(0,1fr);gap:12px;}.poly-case-facts {grid-template-columns:minmax(0,1fr);gap:5px;}.poly-case-facts dt:not(:first-child){margin-top:12px;}
    .poly-print-layout,.poly-photo-grid {grid-template-columns:minmax(0,1fr);gap:24px;}
    table {min-width:640px;}
  }
</style>
