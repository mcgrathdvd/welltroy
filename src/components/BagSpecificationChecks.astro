---
import { bagSpecifications } from '../bag-specification.mjs';
const { product, catalogueImage } = Astro.props;
const spec = bagSpecifications[product.slug];
const zipper = product.slug === 'zipper-bags';
---
<section class="section specification-section" id="specification-checks" aria-labelledby="specification-heading">
  <div class="container">
    <p class="eyebrow">Product specification &amp; visual references</p><h2 id="specification-heading">{spec.title}</h2><p class="lead">{spec.intro}</p>
    <div class="specification-layout">
      <div>
        <p class="table-scroll-hint">Swipe or scroll the table to compare the specification checks.</p>
        <div class="table-wrap" role="region" tabindex="0" aria-label={`${product.name} order specification checks`}><table><caption>{product.name}: reference information and details to agree for your order</caption><thead><tr><th scope="col">Specification</th><th scope="col">{product.isNew ? 'Published product information' : 'Catalogue / project reference'}</th><th scope="col">Agree for your quotation</th></tr></thead><tbody>{spec.rows.map(([label, reference, confirm]) => <tr><th scope="row">{label}</th><td>{reference}</td><td>{confirm}</td></tr>)}</tbody></table></div>
      </div>
      <aside class="specification-visual">
        <figure>
          <svg viewBox="0 0 520 330" role="img" aria-labelledby="spec-drawing-title spec-drawing-description">
            <title id="spec-drawing-title">{zipper ? 'Zipper bag outer dimensions and usable space below the closure' : 'Bubble mailer outer width, body length and separate flap'}</title>
            <desc id="spec-drawing-description">Measurement illustration, not to scale. Catalogue outer dimensions and usable inner space are separate measurements; confirm the selected construction.</desc>
            <defs><marker id="spec-dimension-arrow" markerWidth="7" markerHeight="7" refX="3.5" refY="3.5" orient="auto-start-reverse"><path d="M 7 0 L 0 3.5 L 7 7" fill="currentColor" /></marker></defs>
            <rect x="140" y="60" width="200" height="220" rx="8" fill="white" stroke="currentColor" stroke-width="2" />
            <rect x="159" y="123" width="162" height="137" rx="5" fill="#f3f4ef" stroke="#8d9c93" stroke-dasharray="5 5" />
            <path d="M140 36 H340" fill="none" stroke="currentColor" marker-start="url(#spec-dimension-arrow)" marker-end="url(#spec-dimension-arrow)" />
            <text x="240" y="23" text-anchor="middle">Outer width</text>
            {zipper ? <>
              <path d="M140 105 H340 M140 110 H340" stroke="currentColor" stroke-width="2" />
              <path d="M375 60 V280" stroke="currentColor" marker-start="url(#spec-dimension-arrow)" marker-end="url(#spec-dimension-arrow)" />
              <text x="390" y="160">Outer</text><text x="390" y="183">height</text>
              <text x="128" y="102" text-anchor="end">Closure</text><text x="128" y="122" text-anchor="end">to confirm</text>
            </> : <>
              <path d="M140 95 H340" stroke="currentColor" stroke-width="2" stroke-dasharray="6 4" />
              <path d="M110 60 V95" stroke="currentColor" marker-start="url(#spec-dimension-arrow)" marker-end="url(#spec-dimension-arrow)" />
              <text x="95" y="82" text-anchor="end">Flap</text>
              <path d="M375 95 V280" stroke="currentColor" marker-start="url(#spec-dimension-arrow)" marker-end="url(#spec-dimension-arrow)" />
              <text x="390" y="175">Outer body</text><text x="390" y="198">length</text>
              {[180,210,240,270,300].map(cx => <circle cx={cx} cy="249" r="9" fill="none" stroke="#8d9c93" />)}
            </>}
            <text x="240" y="177" text-anchor="middle">Usable space:</text><text x="240" y="201" text-anchor="middle">confirm on sample</text>
            <text x="260" y="315" text-anchor="middle" class="drawing-note">Measurement illustration · not to scale</text>
          </svg>
          <figcaption>{zipper ? 'Ask for the clear opening and usable height below the actual closure. The drawing does not identify a particular zipper mechanism or model.' : 'The flap is separate from body length. Lining and seams reduce usable space; confirm the selected bag rather than subtracting an assumed fixed amount.'}</figcaption>
        </figure>
        {product.isNew ? <a class="text-link" href="#brief-specification-checks" data-open-spec-brief>Request usable dimensions for your packed item →</a> : <a class="text-link" href="#size-comparison">Compare packed-item size candidates →</a>}
      </aside>
    </div>
    <div class="specification-references">{product.isNew ? <article><h3>Request Order-Specific Dimensions</h3><p>The current kraft bubble page lists construction details rather than numbered sizes. Request the offered outer dimensions, usable inner space and opening, then test the complete packed item.</p><a class="text-link" href="#brief-specification-checks" data-open-spec-brief>Add your size and opening targets →</a></article> : <article><h3>Use the Original Catalogue Reference</h3><p>{product.sizes.length} listed outer-size references are available for comparison. Confirm material, inner dimensions and current availability for the chosen order.</p><a class="text-link" href={catalogueImage} target="_blank" rel="noopener">Open the original 2025 catalogue page ↗</a></article>}<article><h3>Review Visual Evidence for Your Specification</h3><p>{spec.photoIntro}</p>{spec.photoLink && <p><a class="text-link" href={spec.photoLink}>{spec.photoLabel} →</a></p>}<a class="text-link" href="#brief-specification-checks" data-open-spec-brief data-request-detail-photos>Ask about available detail photos →</a></article></div>
    <div class="button-row"><a class="button" href="#brief-specification-checks" data-open-spec-brief>Add Inner Size, Closure &amp; Packing Requirements</a><a class="text-link" href={spec.guide}>{spec.guideLabel} →</a></div>
    <p class="specification-note">These requests become part of your editable quote brief. Offered specifications, available evidence and the approved sample are agreed for the selected order.</p>
  </div>
</section>
<style>.specification-section{scroll-margin-top:100px;background:var(--cream)}.specification-layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:28px;align-items:start;margin-top:24px}.specification-layout>div,.specification-visual{min-width:0}.specification-section table{min-width:620px;background:#fff}.specification-section th,.specification-section td{vertical-align:top;font-size:.86rem}.specification-section caption{text-align:left;font-size:.85rem;color:var(--muted);padding-bottom:12px;line-height:1.6}.specification-visual{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px}.specification-visual figure{margin:0 0 18px}.specification-visual svg{display:block;width:100%;height:auto;color:var(--ink)}.specification-visual text{font:20px Arial,sans-serif;fill:currentColor}.specification-visual .drawing-note{font-size:14px;fill:var(--muted)}.specification-visual figcaption{font-size:.82rem;line-height:1.65;color:var(--muted);margin-top:14px}.specification-references{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin:28px 0}.specification-references article{min-width:0;background:#fff;border:1px solid var(--line);border-radius:12px;padding:22px}.specification-references h3{font-size:1.1rem;margin:0 0 10px}.specification-references p{font-size:.9rem;line-height:1.7}.specification-note{font-size:.85rem;line-height:1.65;color:var(--muted);margin-top:16px}.specification-section .button{white-space:normal}@media(max-width:980px){.specification-layout{grid-template-columns:1fr}.specification-visual{max-width:560px}}@media(max-width:600px){.specification-references{grid-template-columns:1fr}.specification-references article{padding:18px}}</style>
