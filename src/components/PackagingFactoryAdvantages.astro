---
import FactoryReferenceImage from './FactoryReferenceImage.astro';
import overview from '../assets/factory-evidence/custom-packaging-process.png';
const services = [
  { value: '500+ pcs', label: 'Eligible mailer MOQ', detail: 'Per confirmed size, color and design.', href: '/guides/custom-packaging-500-pieces/' },
  { value: '24 hours', label: 'Initial design draft', detail: 'Free, after a clear specification and artwork brief.', href: '/guides/logo-artwork-checklist/' },
  { value: 'From 3 days', label: 'Sample preparation', detail: 'After specifications and artwork are confirmed.', href: '/ordering/' },
  { value: '15–20 days', label: 'Typical production', detail: 'After payment; confirm the start milestone. Shipping is additional.', href: '/ordering/' },
  { value: 'Per order', label: 'Quality review', detail: 'Agree checks against the sample and written specification.', href: '#quality-control' }
];
const strengths = [
  { n: '01', title: 'Size around your product', text: 'Start with a confirmed catalogue size or request custom dimensions. Review usable space, contents and closure before approving the sample.', href: '/products/' },
  { n: '02', title: 'Build your brand into the brief', text: 'Review logo layout, print sides, color references and the requested finish together with material, thickness and adhesive or zipper options.', href: '/guides/logo-artwork-checklist/' },
  { n: '03', title: 'Check the sample before bulk production', text: 'Use a sample to confirm fit, appearance and the checks needed for your packed item. Keep the agreed reference with the approved artwork.', href: '/guides/custom-mailer-sample-approval/' },
  { n: '04', title: 'Keep the order clearly documented', text: 'Confirm the specification, quantity per version, packing, inspection criteria and delivery scope in the written quotation.', href: '/guides/compare-custom-mailer-quotes/' }
];
---
<section class="section" id="factory-advantages"><div class="container">
  <div class="section-head"><div><p class="eyebrow">Why work with Welltroy</p><h2>Custom Packaging with a Clear Path to Production</h2><p class="lead">Poly mailers, bubble mailers and clothing zipper bags, prepared around your product, artwork and order requirements.</p></div></div>
  <div class="factory-service-grid">{services.map(service => <a class="factory-service" href={service.href}><strong>{service.value}</strong><span>{service.label}</span><small>{service.detail}</small></a>)}</div>
  <FactoryReferenceImage source={overview} alt="Welltroy packaging process infographic covering eligible mailer minimums, design and sample timing, seven production checkpoints, customization options and buyer approval records" caption="Custom packaging process overview. The workflow and customization points are also explained in the text below." label="View full process graphic" />
  <div class="factory-strength-grid">{strengths.map(item => <article><span class="factory-strength-number" aria-hidden="true">{item.n}</span><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={item.href}>Review the details →</a></article>)}</div>
  <p class="factory-terms">Confirm the minimum for each specification and the sample type, preparation schedule and shipping charges in your quotation. <a class="text-link" href="/ordering/">Read sample and ordering terms →</a></p>
</div></section>
<style>
  #factory-advantages{scroll-margin-top:110px}.factory-service-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin:0 0 30px}
  .factory-service{background:var(--cream);padding:24px 18px;display:flex;flex-direction:column;text-decoration:none;color:var(--ink);min-width:0;transition:background .2s}.factory-service:hover{background:#f3eddf}.factory-service strong{font-size:1.5rem;color:var(--green,#164f39);line-height:1.2;margin-bottom:12px}.factory-service span{font-weight:650;font-size:.95rem}.factory-service small{margin-top:8px;line-height:1.5;color:var(--muted)}
  .factory-strength-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin:32px 0 20px}.factory-strength-grid article{border:1px solid var(--line);border-radius:14px;padding:28px;min-width:0}.factory-strength-number{font-family:var(--font-mono,monospace);color:#8c591a;font-size:.8rem}.factory-strength-grid h3{font-size:1.3rem;margin:12px 0}.factory-strength-grid p{color:var(--muted);line-height:1.7}.factory-terms{font-size:.9rem;color:var(--muted);max-width:960px}
  @media(max-width:980px){.factory-service-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:600px){.factory-service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.factory-service{padding:20px 16px}.factory-service:last-child{grid-column:1/-1}.factory-service strong{font-size:1.3rem}.factory-strength-grid{grid-template-columns:minmax(0,1fr);gap:16px}.factory-strength-grid article{padding:22px}}
</style>
