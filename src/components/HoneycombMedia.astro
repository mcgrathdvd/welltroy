---
import expanded from "../assets/honeycomb/expanding-paper.jpg";
import gifts from "../assets/honeycomb/wrapped-gifts.jpg";
import giftColors from "../assets/honeycomb/gift-wrap-colors.jpg";
import steps from "../assets/honeycomb/wrapping-steps.jpg";
import dispenser from "../assets/honeycomb/two-roll-dispenser.jpg";
import { getProductVisual } from "../product-images.mjs";

const { variant } = Astro.props;
const expandedView = { source: expanded, crop: [37.5, 22, 60, 33], alt: "Hands stretching brown paper to open the honeycomb cells", title: "Expanded honeycomb cells", caption: "Open the cells evenly before wrapping the item." };
const productViews = [
  expandedView,
  { source: gifts, crop: [2, 26, 96, 72], alt: "Gift boxes wrapped in expanded kraft honeycomb paper and tied with ribbon", title: "Wrapped gift boxes", caption: "Check how the expanded paper sits around the faces and corners of the box." }
];
const colorViews = [
  { source: giftColors, crop: [3, 19, 94, 79], alt: "Natural kraft and pale pink honeycomb wraps around bottles and gift boxes", title: "Paper colors on wrapped items", caption: "Approve a physical color sample before choosing a repeat order." },
  expandedView
];
const guideViews = [
  { source: steps, crop: [3, 21, 44, 28.7], alt: "A kraft roll with honeycomb paper drawn out on a table", title: "1. Open the cells", caption: "Draw out a trial length and stretch gently." },
  { source: steps, crop: [52, 21, 44, 28.7], alt: "Hands wrapping an item in expanded paper", title: "2. Wrap with overlap", caption: "Overlap the edges and check coverage at the ends and corners." },
  { source: steps, crop: [3, 59, 44, 29], alt: "Hands separating the paper at the end of a wrap", title: "3. Separate the sheet", caption: "Record the amount of unexpanded paper used for the pack." },
  { source: steps, crop: [52, 59, 44, 29], alt: "Wrapped items and paper fill arranged inside a box", title: "4. Check the carton", caption: "Pack the wrapped item and check how much it can move." }
];
const dispenserView = { source: dispenser, crop: [4, 26, 90, 47], alt: "Bench dispenser holding a brown honeycomb paper roll and white interleaf", title: "Two-roll dispenser", caption: "Confirm the core fit, interleaf and included accessories in your quote." };
const photos = variant === "guide" ? [...guideViews, dispenserView] : variant === "colors" ? colorViews : productViews;
const views = await Promise.all(photos.map(async ({ source, crop, alt, title, caption }) => {
  const [x, y, width, height] = crop;
  return {
    alt, title, caption, visual: await getProductVisual(source),
    sizes: `(max-width: 640px) calc(${10000 / width}vw - ${6000 / width}px), ${source.width}px`,
    frameStyle: `--crop-ratio:${source.width * width} / ${source.height * height}; --image-width:${10000 / width}%; --image-left:${-100 * x / width}%; --image-top:${-100 * y / height}%`
  };
}));
---
<div class="honeycomb-media">
  <div class="honeycomb-photos">
    {views.map(({ visual, alt, title, caption, frameStyle, sizes }, index) => (
      <figure id={variant === "rolls" && index === 0 ? "wrapping-demo" : undefined} class:list={{ "dispenser-photo": variant === "guide" && index === guideViews.length }}>
        <div class="photo-frame" style={frameStyle}>
          <img src={visual.image} srcset={visual.imageSrcSet} sizes={sizes} alt={alt} width={visual.imageWidth} height={visual.imageHeight} loading="lazy" decoding="async" />
        </div>
        <figcaption><strong>{title}</strong><span>{caption}</span></figcaption>
      </figure>
    ))}
  </div>
</div>
<style>
  .honeycomb-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  figure { margin: 0; min-width: 0; padding: 12px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); scroll-margin-top: 110px; }
  .photo-frame { position: relative; overflow: hidden; aspect-ratio: var(--crop-ratio); border-radius: 9px; }
  .photo-frame img { position: absolute; max-width: none; width: var(--image-width); height: auto; left: var(--image-left); top: var(--image-top); }
  figcaption { display: grid; gap: 4px; padding: 12px 4px 4px; color: var(--muted); font-size: .9rem; }
  figcaption strong { color: var(--ink); font-size: 1rem; }
  .dispenser-photo { display: grid; grid-column: 1 / -1; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 16px; align-items: center; }
  @media (max-width: 640px) {
    .honeycomb-photos, .dispenser-photo { grid-template-columns: 1fr; }
    .dispenser-photo { gap: 0; }
  }
</style>
