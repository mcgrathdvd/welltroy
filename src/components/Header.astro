---
import { products, productGroups } from "../data.mjs";
import { reviews } from "../reviews.mjs";
import { catalogue } from "../ordering.mjs";
const { quoteHref = "/quote/#quote-form" } = Astro.props;

const items = [
  { id: "products", label: "Products", href: "/products/", overview: "View all products", groups: productGroups },
  { id: "industries", label: "Industries", href: "/industries/", overview: "Explore all applications", links: [
    { label: "Apparel & Fashion", href: "/industries/#apparel" },
    { label: "Beauty & Jewelry", href: "/industries/#beauty" },
    { label: "E-commerce & Fulfillment", href: "/industries/#fulfillment" },
    { label: "Gifts & Homeware", href: "/industries/#gifts" }
  ] },
  { id: "why", label: "Why Welltroy", href: "/why-welltroy/", overview: "Our sourcing process", links: [
    { label: "Specifications & artwork", href: "/why-welltroy/#specification-review" },
    { label: "Production gallery", href: "/why-welltroy/#factory-photos" },
    { label: "Before production", href: "/why-welltroy/#order-checkpoints" }
  ] },
  { id: "reviews", label: "Reviews", href: "/reviews/", overview: "Read all buyer reviews", links: reviews.map((review) => ({
    label: review.country, href: `/reviews/#review-${review.country.toLowerCase().replaceAll(" ", "-")}`
  })) },
  { id: "guide", label: "Buying Guide", href: "/guides/choose-a-mailer/", overview: "Choose the right mailer", links: [
    { label: "Clothing mailer size guide", href: "/guides/mailer-size-for-clothing/" },
    { label: "Logo artwork checklist", href: "/guides/logo-artwork-checklist/" },
    { label: "500-piece quote checklist", href: "/guides/custom-packaging-500-pieces/" },
    { label: "MOQ, samples & payment", href: "/faq/#ordering" },
    { label: "Printing & materials", href: "/faq/#customization" },
    { label: "Production & delivery", href: "/faq/#shipping" }
  ] },
  { id: "about", label: "About", href: "/about/", overview: "About Welltroy", links: [
    { label: "Contact details", href: "/about/#contact" },
    { label: "Current product guide", href: "/catalogue/" },
    { label: "Original catalogue (PDF)", href: catalogue.path },
    { label: "Production gallery", href: "/why-welltroy/#factory-photos" }
  ] },
  { id: "faq", label: "FAQ", href: "/faq/", overview: "All buyer questions", links: [
    { label: "Ordering & quotation", href: "/faq/#ordering" },
    { label: "Product specifications", href: "/faq/#specifications" },
    { label: "Printing & materials", href: "/faq/#customization" },
    { label: "Production & delivery", href: "/faq/#shipping" }
  ] }
];
---
<header class="site-header">
  <div class="container nav">
    <a class="brand brand-official" href="/" aria-label="Welltroy home">
      <span class="brand-logo-window"><img src="/images/welltroy-logo.svg" alt="Welltroy" width="770" height="456" /></span>
    </a>
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="nav-links" id="site-nav" data-nav aria-label="Main navigation">
      {items.map((item) => <div class:list={["nav-item", { "nav-item-products": item.groups }]} data-dropdown>
        <a class="nav-mobile-link" href={item.href}>{item.label}</a>
        <button class="nav-trigger" type="button" data-dropdown-toggle aria-expanded="false" aria-controls={`nav-${item.id}`}>
          {item.label}<svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class:list={["nav-dropdown", { "nav-dropdown-products": item.groups }]} id={`nav-${item.id}`} hidden>
          <a class="nav-overview" href={item.href}>{item.overview}<span aria-hidden="true">↗</span></a>
          {item.groups ? <><a class="nav-new-products" href="/products/#new-products">New Products · 8 <span aria-hidden="true">→</span></a><div class="nav-product-groups">{item.groups.map((group, index) => <div><a class="nav-group-title" href={`/products/#group-${index + 1}`}>{group.name}</a>{group.slugs.map((slug) => <a href={`/products/${slug}/`}>{products.find((product) => product.slug === slug).name}</a>)}</div>)}</div></> : <div class="nav-dropdown-links">{item.links.map((link) => <a href={link.href}>{link.label}</a>)}</div>}
        </div>
      </div>)}
      <a class="button nav-quote" href={quoteHref} aria-label="Request a Quote"><span class="nav-quote-desktop"><span aria-hidden="true">→</span> GET QUOTE</span><span class="nav-quote-mobile">Request a Quote</span></a>
    </nav>
  </div>
</header>
