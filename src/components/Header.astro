---
import { products, productGroups, newProducts } from "../data.mjs";
import { catalogue } from "../ordering.mjs";
const { quoteHref = "/quote/#quote-form" } = Astro.props;
const currentPath = Astro.url.pathname;
const currentPage = (href) => href === currentPath ? 'page' : undefined;
const currentSection = (item) => currentPath === item.href
  || (item.id === 'products' && currentPath.startsWith('/products/'))
  || (item.id === 'guide' && (currentPath.startsWith('/guides/') || currentPath === '/ordering/' || currentPath === '/faq/'))
  || (item.id === 'about' && currentPath === '/catalogue/');

const items = [
  { id: "products", label: "Products", href: "/products/", overview: "View all products", groups: productGroups },
  { id: "industries", label: "Industries", href: "/industries/", overview: "Explore all applications", links: [
    { label: "Apparel & Fashion", href: "/industries/#apparel" },
    { label: "Beauty & Jewelry", href: "/industries/#beauty" },
    { label: "E-commerce & Fulfillment", href: "/industries/#fulfillment" },
    { label: "Gifts & Homeware", href: "/industries/#gifts" }
  ] },
  { id: "why", label: "Why Welltroy", href: "/why-welltroy/", overview: "Our sourcing process", links: [
    { label: "Specifications & artwork", href: "/why-welltroy/#specification-review" },
    { label: "Production gallery", href: "/why-welltroy/#factory-photos" },
    { label: "Before production", href: "/why-welltroy/#order-checkpoints" }
  ] },
  { id: "guide", label: "Buying Guide", href: "/guides/", overview: "All buying guides & FAQs", links: [
    { label: "Product selection & sizing", href: "/guides/#select" },
    { label: "Artwork & customization", href: "/guides/#customize" },
    { label: "Quotes & sample approval", href: "/guides/#approve" },
    { label: "FAQ — common buyer questions", href: "/faq/" },
    { label: "Samples, payment & delivery", href: "/ordering/" }
  ] },
  { id: "about", label: "About", href: "/about/", overview: "About Welltroy", links: [
    { label: "Contact details", href: "/about/#contact" },
    { label: "Current product guide", href: "/catalogue/" },
    { label: "Original catalogue (PDF)", href: catalogue.path },
    { label: "Production gallery", href: "/why-welltroy/#factory-photos" }
  ] }
];
---
<header class="site-header">
  <div class="container nav">
    <a class="brand brand-official" href="/" aria-label="Welltroy home">
      <span class="brand-logo-window"><img src="/images/welltroy-logo.svg" alt="Welltroy" width="770" height="456" /></span>
    </a>
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="nav-links" id="site-nav" data-nav aria-label="Main navigation">
      {items.map((item) => <div class:list={["nav-item", { "nav-item-products": item.groups }]} data-dropdown data-current={currentSection(item) || undefined}>
        <a class="nav-mobile-link" href={item.href} aria-current={currentPage(item.href)}>{item.label}</a>
        <button class="nav-trigger" type="button" data-dropdown-toggle aria-expanded="false" aria-controls={`nav-${item.id}`}>
          {item.label}<svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <div class:list={["nav-dropdown", { "nav-dropdown-products": item.groups }]} id={`nav-${item.id}`} hidden>
          <a class="nav-overview" href={item.href} aria-current={currentPage(item.href)}>{item.overview}<span aria-hidden="true">↗</span></a>
          {item.groups ? <><a class="nav-new-products" href="/products/#new-products">New Products · {newProducts.length} <span aria-hidden="true">→</span></a><div class="nav-product-groups">{item.groups.map((group, index) => <div><a class="nav-group-title" href={`/products/#group-${index + 1}`}>{group.name}</a>{group.slugs.map((slug) => <a href={`/products/${slug}/`}>{products.find((product) => product.slug === slug).name}</a>)}</div>)}</div></> : <div class="nav-dropdown-links">{item.links.map((link) => <a href={link.href}>{link.label}</a>)}</div>}
        </div>
      </div>)}
      <a class="button nav-quote" href={quoteHref} data-quote-placement="header" aria-label="Request a Quote"><span class="nav-quote-desktop"><span aria-hidden="true">→</span> GET QUOTE</span><span class="nav-quote-mobile">Request a Quote</span></a>
    </nav>
  </div>
</header>
