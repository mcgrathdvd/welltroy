---
// Public measurement identifier confirmed in the user's GA4 Web stream.
const raw = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? 'G-R2B5B1072P';
const measurementId = /^G-[A-Z0-9]{5,20}$/.test(raw) ? raw : '';
const { pageTitle = 'Welltroy' } = Astro.props;
---
<span hidden data-analytics-config data-measurement-id={measurementId} data-page-title={pageTitle}></span>
<section class="analytics-choice" data-analytics-banner hidden aria-label="Optional website analytics">
  <div><strong>Optional analytics</strong><p>Allow Google Analytics cookies to improve this site? You can enquire either way. <a href="/privacy/#website-analytics">Details</a></p></div>
  <div class="analytics-choice-actions"><button type="button" data-analytics-reject>Decline</button><button type="button" data-analytics-accept>Allow</button></div>
</section>
<style>
  .analytics-choice[hidden] {display:none;}
  .analytics-choice {position:fixed;z-index:1100;bottom:16px;left:16px;width:min(390px,calc(100vw - 32px));background:#fff;color:#203c30;border:1px solid #cbd5cc;border-radius:14px;box-shadow:0 4px 24px #203c3020;padding:14px;max-height:45vh;overflow:auto;}
  .analytics-choice strong {font-size:.92rem;}
  .analytics-choice p {font-size:.8rem;line-height:1.5;margin:5px 0 0;}
  .analytics-choice-actions {display:flex;gap:10px;margin-top:12px;}
  .analytics-choice button {flex:1;background:#fff;border:1px solid #203c30;color:#203c30;padding:9px 12px;min-height:44px;border-radius:8px;cursor:pointer;font:inherit;font-size:.85rem;}
  .analytics-choice a {text-decoration:underline;}
  @media(max-width:700px) {.analytics-choice {bottom:calc(76px + env(safe-area-inset-bottom));left:12px;width:calc(100vw - 24px);padding:12px;}}
</style>
