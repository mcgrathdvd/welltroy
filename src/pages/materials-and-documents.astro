---
import Layout from '../layouts/Layout.astro';
import CertificateReferences from '../components/CertificateReferences.astro';
import DocumentRequestBuilder from '../components/DocumentRequestBuilder.astro';
import { site } from '../data.mjs';
const path = '/materials-and-documents/';
const title = 'Packaging Certificates, Reports & Material Evidence';
const documentTypes = [
  { name: 'Company and production responsibility confirmation', request: 'Contracting legal entity, relevant production location, who performs each proposed step, subcontracted work and available supporting records.', match: 'Connect the reply to the company and production route offered for your bag. Record any unresolved identity, site or responsibility questions.' },
  { name: 'Walkthrough or independent inspection scope', request: 'Relevant location and operations, availability, dates and time zone, access, confidentiality, scope and any charges.', match: 'Distinguish a site introduction from inspection of a particular order. Confirm arrangements separately before relying on them.' },
  { name: 'Material or specification confirmation', request: 'Proposed material, layers or components, thickness convention or paper weight, and product reference.', match: 'Connect the description to your selected bag construction and specification version.' },
  { name: 'Product or material test report', request: 'Report identifier, issuer, sample description, method, conditions, date and stated results.', match: 'Check which material or finished product was tested and which of your requirements the report addresses.' },
  { name: 'Management-system certificate', request: 'Certificate holder, number, standard, scope, covered locations, issuer and current status.', match: 'Identify the certified entity and scope. Review product-specific evidence separately.' },
  { name: 'Evidence for a material or environmental claim', request: 'The precise proposed claim, supporting document and any stated conditions or limitations.', match: 'Identify the product, material or component covered, intended use and destination market.' },
  { name: 'Sample or order inspection record', request: 'Sample or order reference, checks performed, method, acceptance criteria, date and findings.', match: 'Connect the record to the agreed version or batch and retain any unresolved exceptions.' }
];
const brief = `Product or catalogue model:
Proposed material, construction and dimensions:
Quantity and specification or artwork version:
Intended contents, use and destination market:
Document type or requirement to discuss:
Exact claim, test or customer requirement to address:
Product, material, site or batch the document should cover:
Required issuer, method or standard, if specified by your buyer:
Document language and required timing:
Existing document identifier or reference, if any:
Open questions and follow-up contact:`;
const emailHref = `mailto:${site.email}?subject=${encodeURIComponent('Packaging material and supporting document enquiry')}`;
const webpage = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${site.origin}${path}#webpage`, url: `${site.origin}${path}`, name: title, description: 'Welltroy certificate and test report overview, production references and a product-specific document request checklist.', datePublished: '2026-11-02', dateModified: '2026-11-13', inLanguage: 'en', isPartOf: { '@id': `${site.origin}/#website` }, publisher: { '@id': `${site.origin}/#organization` } };
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.origin },
  { '@type': 'ListItem', position: 2, name: 'Documents and material evidence', item: `${site.origin}${path}` }
] };
---
<Layout title={`${title} | Welltroy`} description="View Welltroy ISO 9001, ISO 14001, FSC and test report references. Check current document status and scope for your selected packaging, material and intended use." canonicalPath={path} schemas={[webpage, breadcrumbs]} contactContext="Packaging material and supporting document enquiry">
  <section class="page-hero evidence-page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Documents &amp; Material Evidence</div><p class="eyebrow">References for a clear purchasing decision</p><h1>{title}</h1><p class="lead">Start with our certificate and test report overview, production photographs and published projects. Request the full document and confirm its current scope for your selected packaging, material and intended use.</p><nav class="anchor-links" aria-label="On this page"><a href="#certificate-references">Certificates &amp; reports</a><a href="#available-references">Production &amp; projects</a><a href="#document-scope">Document scope</a><a href="#review-evidence">Review a document</a><a href="#document-request-builder">Build a request</a></nav></div></section>
  <CertificateReferences />
  <section class="section" id="available-references"><div class="container"><p class="eyebrow">What you can review now</p><h2>Production Photographs and Published Project References</h2><p class="lead">Alongside the document overview, explore production photographs, customer projects and catalogue sizes. Use these references to connect your requirements to the proposed construction and order.</p><div class="guide-callout"><strong>Request the complete record for your specification.</strong><p>The overview image is available above. Clear individual certificates, complete laboratory reports and material declarations are not provided as separate downloads here. Confirm current status, availability and applicability before approving a document-dependent purchase.</p></div><div class="grid-2 reference-grid">
    <article class="editorial-card"><p class="eyebrow">Production reference</p><h3>Production and Printing Photographs</h3><p>Seven equipment and workshop views with questions about the site, material handling and relevant operations.</p><a class="text-link" href="/why-welltroy/#factory-photos">Review the production photographs →</a></article>
    <article class="editorial-card"><p class="eyebrow">Published customer project</p><h3>Anonymous Apparel Mailer Project</h3><p>Production and packing photographs from the same customer project, published anonymously with permission.</p><a class="text-link" href="/products/poly-mailers/#poly-mailer-case">View the apparel mailer reference →</a></article>
    <article class="editorial-card"><p class="eyebrow">Published customer project</p><h3>LUMIÈRE Bubble Mailer Project</h3><p>A printed bubble mailer project reference for questions about artwork, construction and your own sample requirements.</p><a class="text-link" href="/products/poly-bubble-mailers/#lumiere-case">View the bubble mailer reference →</a></article>
    <article class="editorial-card"><p class="eyebrow">Product reference</p><h3>Catalogue and Specification Preparation</h3><p>Use the catalogue model and product page to identify a starting configuration, then confirm the offered material and final specification.</p><a class="text-link" href="/catalogue/">Review catalogue references →</a></article>
  </div></div></section>
  <section class="section section-soft" id="document-scope"><div class="container evidence-content"><p class="eyebrow">Request the relevant evidence</p><h2>Which Supporting Document Does Your Order Need?</h2><p>Describe the question the document must answer. The examples below are request categories; listing one here does not mean it is available for every Welltroy product.</p><p class="table-scroll-hint">Swipe or scroll the table to see the document details and scope checks.</p><div class="table-wrap" tabindex="0" role="region" aria-label="Packaging supporting document scope checklist"><table><caption>Match the requested evidence to the selected construction and use</caption><thead><tr><th scope="col">Document category</th><th scope="col">Details to request</th><th scope="col">Scope to check</th></tr></thead><tbody>{documentTypes.map(item => <tr><th scope="row">{item.name}</th><td>{item.request}</td><td>{item.match}</td></tr>)}</tbody></table></div><p>For an undecided product, share the intended contents, destination and the claim or customer requirement you need to address. Ask us to confirm the proposed construction and available evidence before you approve it.</p></div></section>
  <section class="section" id="review-evidence"><div class="container split"><div class="evidence-content"><p class="eyebrow">Keep the evidence connected</p><h2>Review the Document Against Your Specification</h2><ol><li><strong>Identify the subject.</strong> Match the product, material, company or location described to the part of your enquiry it is intended to support.</li><li><strong>Identify the record.</strong> Retain the issuer, document number, date, version and any stated validity or status information.</li><li><strong>Read the scope and findings.</strong> Check the stated method, conditions, results and limitations against your actual requirement.</li><li><strong>Resolve the gaps.</strong> Ask about a different construction, missing pages, unclear identifiers or requirements the document does not address.</li><li><strong>Retain the agreed version.</strong> Keep the reviewed evidence with your specification, sample approval and written quotation. Revisit the scope when relevant materials or construction change.</li></ol><p>For certification questions, ISO explains that external certification bodies issue certificates. Check the relevant issuer and status using its <a href="https://www.iso.org/certification.html" target="_blank" rel="noopener noreferrer">official certification guidance ↗</a>. For applicable accredited management-system certificates, <a href="https://www.iafcertsearch.org/" target="_blank" rel="noopener noreferrer">IAF CertSearch ↗</a> provides a verification route; its <a href="https://support.iafcertsearch.org/iaf-certsearch-faq/iaf-certsearch-faq/general" target="_blank" rel="noopener noreferrer">official explanation ↗</a> describes the certificate details and database scope. Use the document overview above as a starting reference, then verify the relevant complete record and its current status.</p></div><aside class="side-card"><h2>Related Buyer Checks</h2><ul><li><a href="/guides/verify-packaging-bag-factory/#documents">Factory verification and document checks</a></li><li><a href="/why-welltroy/#quality-control">Order-specific quality review</a></li><li><a href="/guides/custom-mailer-sample-approval/#record">Sample approval record</a></li><li><a href="/guides/compare-custom-mailer-quotes/">Quotation and specification comparison</a></li></ul></aside></div></section>
  <section class="section section-soft" id="document-request"><div class="container evidence-content"><p class="eyebrow">Prepare a useful enquiry</p><h2>Request Material or Supporting Document Information</h2><p>Build a request below and carry it to the editable enquiry form. You can also copy a blank brief for email. Describe the requirement your buyer wants to resolve and leave undecided specifications open.</p><DocumentRequestBuilder /><details><summary>Prefer to copy a blank request?</summary><pre class="evidence-brief">{brief}</pre></details><div class="button-row"><a class="button" href="/quote/?product=not-sure#quote-form" data-quote-placement="content">Use a Blank Enquiry</a><a class="button button-secondary" href={emailHref}>Email a Document Enquiry</a></div><p class="muted">A request starts an availability and scope discussion. Confirm which documents can be supplied, the relevant product, timing and any additional work or charges before proceeding.</p></div></section>
  <section class="section"><div class="container evidence-content"><h2>Questions About Packaging Evidence</h2><h3>Can a production photograph confirm the material composition of my bag?</h3><p>A photograph shows a visible reference. Ask for the proposed material and construction in writing, then request evidence appropriate to the specific question your purchase needs to resolve.</p><h3>Can I enquire before knowing the document name?</h3><p>Yes. Describe your packaging, contents, intended use, destination and the customer requirement or claim you need to address. Document availability and the proposed scope still need confirmation.</p><h3>Does a document request guarantee that a certificate or report is available?</h3><p>No. Confirm availability and review the exact scope before relying on a document in your purchasing decision.</p></div></section>
</Layout>
<style>
  .evidence-page-hero{padding-block:52px 44px}.evidence-page-hero h1{font-size:clamp(2.15rem,4.3vw,3.5rem);line-height:1.16;text-wrap:balance;max-width:1050px}.evidence-page-hero .lead{margin-bottom:0}.evidence-page-hero .breadcrumbs{margin-bottom:20px}
  @media(max-width:600px){.evidence-page-hero{padding-block:34px 30px}}
  section[id]{scroll-margin-top:110px}.evidence-content,.reference-grid article{min-width:0}.reference-grid{margin-top:30px}.reference-grid h3{font-size:1.25rem}.reference-grid .eyebrow{font-size:.72rem}.evidence-content li{margin-bottom:14px}.evidence-content h3{margin-top:28px}.evidence-content table{min-width:760px}.evidence-content th,.evidence-content td{vertical-align:top;min-width:190px}.evidence-brief{max-width:900px;white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;line-height:1.7;padding:22px;border:1px solid var(--line);border-radius:12px;background:white}.evidence-content .button{white-space:normal;text-align:center}@media(max-width:600px){.evidence-content .button-row{align-items:stretch}.evidence-content .button{width:100%}}
</style>
