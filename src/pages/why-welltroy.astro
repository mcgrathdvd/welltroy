---
import Layout from "../layouts/Layout.astro";
import ProductionPhoto from "../components/ProductionPhoto.astro";
import { factoryPhotos } from "../factory-images.mjs";
import { site, catalogueProducts, newProducts } from "../data.mjs";

const steps = [
  { n: "01", title: "Define the use", text: "Tell us what is being packed, how it is handled and where it will be delivered." },
  { n: "02", title: "Check the specification", text: "Review size, usable space, material, finish, closure and printing against the selected product." },
  { n: "03", title: "Approve the reference", text: "Confirm artwork, color references and any available sample route before placing a custom order." },
  { n: "04", title: "Confirm order details", text: "Agree on quantity, packing, production schedule and shipping terms in the final quotation." }
];
---
<Layout title="Why Welltroy | Packaging Sourcing Process" description="See how Welltroy helps buyers compare packaging specifications, review customization and prepare clear orders for international delivery." canonicalPath="/why-welltroy/">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Why Welltroy</div><p class="eyebrow">A practical buying process</p><h1>Clear Specifications Lead to Better Packaging Orders</h1><p class="lead">Our catalogue gives buyers a starting point. The next step is matching a product, size and construction to the way it will actually be used.</p></div></section>
  <section class="section" id="specification-review"><div class="container production-overview"><div><p class="eyebrow">What we help you review</p><h2>Compare Options with the Right Details</h2><p>Welltroy offers {catalogueProducts.length} catalogue ranges plus {newProducts.length} new products across mailing, protective, retail and fulfillment packaging. An enquiry can include several products so your team can discuss related needs together.</p><ul class="check-list"><li>Catalogue model and requested dimensions</li><li>Material, thickness or paper weight where relevant</li><li>Color, print coverage and artwork requirements</li><li>Order quantity and destination country</li></ul><div class="button-row"><a class="button" href="/products/">Explore products</a></div></div><ProductionPhoto image="film-handling" /></div></section>
  <section class="section section-soft" id="factory-photos"><div class="container"><div class="section-head"><div><p class="eyebrow">Production gallery</p><h2>Inside Packaging Production</h2><p class="lead">Seven views of production and printing equipment. Select an image to view it larger.</p></div><a class="text-link" href="/quote/">Discuss your packaging ↗</a></div><div class="factory-gallery">{factoryPhotos.map((photo) => <ProductionPhoto image={photo.image} />)}</div></div></section>
  <section class="section" id="order-checkpoints"><div class="container"><div class="section-head"><div><p class="eyebrow">From enquiry to order</p><h2>Four Checkpoints Before Production</h2></div></div><div class="process-grid process-grid-light">{steps.map((step) => <article class="step"><span class="step-no">{step.n}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></div></section>
  <section class="section"><div class="container split"><div><p class="eyebrow">For overseas buyers</p><h2>Questions Worth Settling Early</h2><p class="lead">Buyers in Europe, North America and the Middle East may have different labeling, environmental and product-contact requirements. Share your target market at the enquiry stage so the relevant documentation and packaging details can be discussed.</p><p>For claims such as biodegradability, recyclability or food suitability, request the exact material structure and supporting documents for the selected product. The product name or appearance alone is not enough to confirm compliance.</p></div><aside class="side-card"><h3>Send with your enquiry</h3><ul><li>Product or catalogue model</li><li>Packed product dimensions and weight</li><li>Estimated quantity</li><li>Brand artwork, if available</li><li>Destination country or port</li><li>Any required standard or document</li></ul><div class="button-row"><a class="button" href="/quote/">Prepare an enquiry</a></div></aside></div></section>
  <section class="cta-band"><div class="container inner"><div><h2>Bring Us Your Specification</h2><p>We can review catalogue choices and the information needed for a custom quotation.</p></div><a class="button button-light" href={`mailto:${site.email}`}>Email Welltroy</a></div></section>
</Layout>

