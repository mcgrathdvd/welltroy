---
import Layout from "../layouts/Layout.astro";
import ProductionPhoto from "../components/ProductionPhoto.astro";
import PackagingFactoryAdvantages from "../components/PackagingFactoryAdvantages.astro";
import CertificateReferences from "../components/CertificateReferences.astro";
import { factoryPhotos } from "../factory-images.mjs";
import { site, catalogueProducts, newProducts } from "../data.mjs";

const steps = [
  { n: '01', title: 'Requirement review', text: 'Define the packed item, intended use, quantity and destination.' },
  { n: '02', title: 'Material & size', text: 'Review material, thickness, usable dimensions and closure.' },
  { n: '03', title: 'Artwork & color', text: 'Confirm logo layout, print sides, finish and color references.' },
  { n: '04', title: 'Sample route', text: 'Agree the sample type and check fit, appearance and packed contents.' },
  { n: '05', title: 'Written approval', text: 'Retain the specification, artwork and sample references together.' },
  { n: '06', title: 'Production & packing', text: 'Confirm the start milestone, packing, labels and quantity per version.' },
  { n: '07', title: 'Final checks', text: 'Review the agreed acceptance criteria, records and delivery scope.' }
];
const photoQuestions = {
  'bag-production': 'Ask which bag-making steps apply to your proposed construction.',
  'film-handling': 'Confirm the film specification and how material versions will be identified.',
  'printing-equipment': 'Ask which print process and artwork approval route your design requires.',
  'production-lines': 'Confirm the relevant production site and who performs each operation.',
  'printing-workshop': 'Ask how the agreed artwork and print references will be checked.',
  'printed-rolls': 'Discuss how printed material will be identified through bag making and packing.',
  'roll-fed-production': 'Confirm which material and conversion steps are relevant to your product.'
};
const qualityChecks = [
  { topic: 'Dimensions and usable space', agree: 'Outer and usable inner size, flap or zipper allowance, measurement method and agreed tolerances.', record: 'Sample identifier, specification version and measured dimensions with units.' },
  { topic: 'Material and thickness', agree: 'Proposed material structure, thickness convention or paper weight, and any product-specific document requirements.', record: 'Material description, measurement convention and the scope of any available supporting document.' },
  { topic: 'Artwork and print', agree: 'Artwork version, print sides, placement, colors and the physical or digital reference to approve.', record: 'Approved artwork and reference identifiers; agreed differences and actions.' },
  { topic: 'Seams and closure', agree: 'Relevant seams, adhesive strip, flap or zipper, plus the check method and acceptance criteria for the selected bag.', record: 'Sample or order reference, check conditions, findings and agreed follow-up.' },
  { topic: 'Complete packed item', agree: 'The real contents, inserts, fit and protection checks needed for the intended handling and shipping route.', record: 'Packed-sample description, trial conditions and findings; remaining protection questions.' },
  { topic: 'Finished-order packing', agree: 'Quantity per version, labels, assortment, carton packing and the timing and responsibility for any order inspection.', record: 'Applicable packing or inspection records, order reference and unresolved exceptions.' }
];
const qualityBrief = `Product or catalogue model:
Size and artwork versions, with quantity per version:
Destination and intended use:
Sample and specification references:
Dimensions, units and thickness convention to confirm:
Artwork, print and closure references:
Complete packed item and checks requested:
Check method, tolerances and acceptance criteria to agree:
Inspection responsibility, timing and records requested:
Material documents required and their intended use:
Packing, labels and assortment:
Open questions and required follow-up:`;
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.origin },
  { '@type': 'ListItem', position: 2, name: 'Production and quality review', item: `${site.origin}/why-welltroy/` }
] };
---
<Layout title="Custom Packaging Factory Advantages & Quality | Welltroy" description="Explore Welltroy custom packaging, eligible 500-piece mailer minimums, design and sample support, production photographs, quality checks and document references." canonicalPath="/why-welltroy/" schemas={[breadcrumbs]} contactContext="Packaging production and quality review">
  <section class="page-hero factory-page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Why Welltroy</div><p class="eyebrow">Custom mailers and clothing packaging</p><h1>Custom Packaging, Clearly Specified</h1><p class="lead">From your first design brief to the final packing requirements, Welltroy helps you review size, material, printing, samples and production terms together. Explore our factory advantages, production references and documents before preparing your order.</p><nav class="anchor-links" aria-label="On this page"><a href="#factory-advantages">Factory advantages</a><a href="#factory-photos">Production photographs</a><a href="#factory-documents">Certificates &amp; reports</a><a href="#quality-control">Quality checks to agree</a><a href="#quality-request">Prepare a review request</a></nav></div></section>
  <PackagingFactoryAdvantages />
  <section class="section" id="specification-review"><div class="container production-overview"><div><p class="eyebrow">What we help you review</p><h2>Compare Options with the Right Details</h2><p>Welltroy offers {catalogueProducts.length} catalogue ranges plus {newProducts.length} new products across mailing, protective, retail and fulfillment packaging. An enquiry can include several products so your team can discuss related needs together.</p><ul class="check-list"><li>Catalogue model and requested dimensions</li><li>Material, thickness or paper weight where relevant</li><li>Color, print coverage and artwork requirements</li><li>Order quantity and destination country</li></ul><div class="button-row"><a class="button" href="/products/">Explore products</a></div></div><ProductionPhoto image="film-handling" /></div></section>
  <section class="section section-soft" id="factory-photos"><div class="container"><div class="section-head"><div><p class="eyebrow">Production gallery</p><h2>Inside Packaging Production</h2><p class="lead">Seven views of production and printing equipment, with questions to connect each view to your proposed order. Select an image to view it larger.</p></div><a class="text-link" href="#quality-request">Discuss your packaging ↗</a></div><div class="factory-gallery">{factoryPhotos.map((photo) => <ProductionPhoto image={photo.image} detail={`${photo.detail}. ${photoQuestions[photo.image]}`} />)}</div><div class="guide-callout"><strong>Use the photographs to start a specific discussion.</strong><p>Ask which site and operations relate to your product, which steps are performed by production partners, and what can be reviewed for your order. A photograph does not establish the material specification, production capacity, certification status or inspection result of a particular batch.</p></div></div></section>
  <section class="section section-soft" id="supplier-verification"><div class="container guide-callout"><p class="eyebrow">Prepare your supplier review</p><h2>How Should I Verify a Packaging Supplier?</h2><p>Connect the company details and relevant production operations to the bag you intend to order. Use a checklist for site questions, a possible walkthrough, sample references and supporting documents before agreeing the final specification.</p><a class="text-link" href="/guides/verify-packaging-bag-factory/">Use the packaging factory verification checklist →</a></div></section>
  <section class="section" id="order-checkpoints"><div class="container"><div class="section-head"><div><p class="eyebrow">From enquiry to order</p><h2>Seven Checkpoints from Brief to Final Review</h2></div></div><div class="process-grid process-grid-light factory-workflow">{steps.map((step) => <article class="step"><span class="step-no">{step.n}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></div></section>
  <CertificateReferences compact />
  <section class="section section-soft" id="quality-control"><div class="container quality-content"><p class="eyebrow">Plan the quality review</p><h2>What Quality Checks Should We Agree for Your Packaging?</h2><p class="lead">Use the points below to prepare an order-specific review. Confirm the check method, tolerances, acceptance criteria, responsible party and available records in writing before production.</p><p>The scope depends on the selected bag and intended use. These are discussion points for your order; the applicable checks, document availability and any inspection arrangements need separate confirmation.</p><p class="table-scroll-hint">Swipe or scroll the table to see the details and records to discuss.</p><div class="table-wrap" tabindex="0" role="region" aria-label="Packaging quality review checklist"><table><caption>Checks to agree against your sample and specification</caption><thead><tr><th scope="col">Review point</th><th scope="col">What to agree</th><th scope="col">Record to request, if available</th></tr></thead><tbody>{qualityChecks.map((check) => <tr><th scope="row">{check.topic}</th><td>{check.agree}</td><td>{check.record}</td></tr>)}</tbody></table></div><p>Keep the approved reference with the <a href="/guides/custom-mailer-sample-approval/#record">sample approval record</a> and <a href="/guides/compare-custom-mailer-quotes/">final quotation</a>. If the material, artwork, dimensions or closure changes, identify which checks and approvals need to be repeated. A site walkthrough and an inspection of your finished order have different scopes; use the <a href="/guides/verify-packaging-bag-factory/#walkthrough">factory walkthrough checklist</a> to prepare the site discussion.</p></div></section>
  <section class="section" id="quality-request"><div class="container split"><div class="quality-content"><p class="eyebrow">Keep the request practical</p><h2>Send a Production and Quality Review Brief</h2><p>Describe your packaging and the records or checks you need. Mark unknown specifications as open. Paste this brief into the online enquiry form, or download it and complete it for your team.</p><pre class="quality-brief">{qualityBrief}</pre><div class="button-row"><a class="button" href="/quote/?product=not-sure#quote-form" data-quote-placement="content">Discuss Production and Quality Requirements</a><a class="text-link" href="/downloads/packaging-quality-review-brief.txt" download>Download editable quality review brief (TXT) →</a></div><p class="muted">For the online form, paste the brief into Packaging and printing requirements. Confirm the scope, timing, availability and any charges for samples, records or inspections separately.</p></div><aside class="side-card"><h2>Start with the Available References</h2><p>Review the production photographs, certificate and test report overview, and published customer projects. Ask which complete records can be shared for your selected product.</p><ul><li><a href="/products/poly-mailers/#poly-mailer-case">Anonymous apparel mailer project</a></li><li><a href="/products/poly-bubble-mailers/#lumiere-case">LUMIÈRE bubble mailer project</a></li><li><a href="/guides/verify-packaging-bag-factory/">Supplier verification guide</a></li><li><a href="/ordering/">Sample and ordering terms</a></li><li><a href="/materials-and-documents/#certificate-references">Certificate and test report overview</a></li></ul><p>For material or product claims, specify the document you need and its intended market and use. Ask us to confirm whether evidence is available for the proposed construction before relying on a claim.</p></aside></div></section>
  <section class="section"><div class="container split"><div><p class="eyebrow">For overseas buyers</p><h2>Questions Worth Settling Early</h2><p class="lead">Buyers in Europe, North America and the Middle East may have different labeling, environmental and product-contact requirements. Share your target market at the enquiry stage so the relevant documentation and packaging details can be discussed.</p><p>For claims such as biodegradability, recyclability or food suitability, request the exact material structure and supporting documents for the selected product. The product name or appearance alone is not enough to confirm compliance.</p><p><a class="text-link" href="/materials-and-documents/#document-request">Review available references and prepare a material document request →</a></p></div><aside class="side-card"><h3>Send with your enquiry</h3><ul><li>Product or catalogue model</li><li>Packed product dimensions and weight</li><li>Estimated quantity</li><li>Brand artwork, if available</li><li>Destination country or port</li><li>Any required standard or document</li></ul><div class="button-row"><a class="button" href="/quote/">Prepare an enquiry</a></div></aside></div></section>
  <section class="cta-band"><div class="container inner"><div><h2>Bring Us Your Specification</h2><p>We can review catalogue choices and the information needed for a custom quotation.</p></div><a class="button button-light" href={`mailto:${site.email}`}>Email Welltroy</a></div></section>
</Layout>
<style>
  section[id]{scroll-margin-top:110px}
  .factory-page-hero{padding-block:52px 44px}.factory-page-hero h1{font-size:clamp(2.15rem,4.3vw,3.5rem);line-height:1.16;text-wrap:balance;max-width:1000px}.factory-page-hero .lead{margin-bottom:0}.factory-page-hero .breadcrumbs{margin-bottom:20px}
  #order-checkpoints{padding-block:64px}#order-checkpoints .section-head{margin-bottom:28px}#order-checkpoints h2{font-size:clamp(1.85rem,3.2vw,2.6rem);line-height:1.18;text-wrap:balance}.factory-workflow{grid-template-columns:repeat(12,minmax(0,1fr))}.factory-workflow .step{min-width:0;grid-column:span 3;padding:26px}.factory-workflow .step:nth-child(n+5){grid-column:span 4}.factory-workflow h3{line-height:1.3;margin-top:18px}
  @media(max-width:980px){.factory-workflow{grid-template-columns:repeat(2,minmax(0,1fr))}.factory-workflow .step,.factory-workflow .step:nth-child(n+5){grid-column:auto}.factory-workflow .step:last-child{grid-column:1/-1}}
  @media(max-width:600px){.factory-page-hero{padding-block:34px 30px}#order-checkpoints{padding-block:44px}.factory-workflow{grid-template-columns:minmax(0,1fr)}.factory-workflow .step{padding:22px}}
  .quality-content{min-width:0}
  .quality-content table{min-width:760px}
  .quality-content th,.quality-content td{vertical-align:top;min-width:190px}
  .quality-content th[scope="row"]{min-width:145px}
  .quality-brief{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;line-height:1.7;padding:22px;border:1px solid var(--line);border-radius:12px;background:var(--cream)}
  #quality-request .button-row{align-items:flex-start;flex-direction:column}
  #quality-request .button{white-space:normal;text-align:center}
  @media(max-width:600px){#quality-request .button{width:100%}}
</style>

