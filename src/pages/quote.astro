---
import Layout from "../layouts/Layout.astro";
import { products, site } from "../data.mjs";
import { assistedChoices } from "../quote-options.mjs";
import { orderTerms } from "../ordering.mjs";
---
<Layout title="Request a Packaging Quote | Welltroy" description="Request pricing for Welltroy mailers, bags, pouches, labels and protective packaging. Share the product, quantity, size and destination." canonicalPath="/quote/">
  <section class="page-hero quote-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Request a Quote</div><p class="eyebrow">Packaging enquiry</p><h1>Tell Us What You Need to Pack</h1><p class="lead">Tell us what you need to pack, your estimated quantity and destination. Choose a product, enquire about several items, or ask us to help you choose. You can attach your logo or reference files below.</p></div></section>
  <section class="section quote-main"><div class="container quote-layout"><aside><h2>Details That Help</h2><p>A clear specification helps us prepare a more relevant response.</p><ul class="check-list"><li>Product type and intended use</li><li>Catalogue model or custom dimensions</li><li>Estimated order quantity</li><li>Logo or printing requirements</li><li>Destination country or port</li></ul><div class="quote-timing"><strong>Design & samples</strong><span>Free initial design draft within 24 hours after a clear brief.</span><span>{orderTerms.sample}</span><span>Bulk production: {orderTerms.production}</span><span>Payment: {orderTerms.payment}</span><small>Timing depends on product, artwork and destination.</small></div><p><strong>Email</strong><br /><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></p><p><strong>WhatsApp</strong><br /><a class="text-link" href={`https://wa.me/${site.whatsapp}`} rel="noopener">{site.phone}</a></p></aside><form id="quote-form" class="quote-form" data-quote-form action="/api/quote" method="post" enctype="multipart/form-data"><section class="quote-success" data-success hidden aria-labelledby="enquiry-success-title"><p class="eyebrow">Enquiry sent</p><h2 id="enquiry-success-title" tabindex="-1">Thank you for your enquiry</h2><p data-success-summary></p><p>Our team will review your requirements and reply to the email address you provided. Keep this reference when contacting us about your enquiry.</p><p class="enquiry-reference">Enquiry reference<br /><strong data-enquiry-reference></strong></p><div class="button-row"><button class="button" type="button" data-new-enquiry>Send another enquiry</button><a class="button button-secondary" href="/products/">Browse products</a></div></section><div data-form-fields><noscript><p>Please enable JavaScript to submit this form, or email <a href="mailto:info@welltroy.com">info@welltroy.com</a>.</p></noscript><div class="quote-service" data-service-panel data-state="loading"><p class="quote-service-message" data-service-status role="status" aria-live="polite">Checking online enquiry availability…</p><div data-turnstile></div><div class="quote-service-actions" data-service-actions hidden><a class="text-link" href="mailto:info@welltroy.com">Email us ↗</a><a class="text-link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><button type="button" class="service-retry" data-service-retry>Try again</button></div></div><div class="form-trap" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div><div class="form-grid"><div class="field"><label for="name">Name *</label><input id="name" name="name" maxlength="100" required autocomplete="name" /></div><div class="field"><label for="company">Company</label><input id="company" name="company" maxlength="160" autocomplete="organization" /></div><div class="field"><label for="email">Email address *</label><input id="email" name="email" maxlength="254" type="email" required autocomplete="email" /></div><div class="field"><label for="whatsapp">WhatsApp number</label><input id="whatsapp" name="whatsapp" maxlength="50" type="tel" autocomplete="tel" /></div><div class="field"><label for="product">Product *</label><select id="product" name="product" required aria-describedby="product-help"><option value="">Select a product or ask for help</option>{assistedChoices.map((choice) => <option value={choice.slug}>{choice.name}</option>)}{products.map((product) => <option value={product.slug}>{product.name}</option>)}</select><small class="field-help" id="product-help" data-product-help>Choose a product, or ask us to help you choose.</small></div><div class="field"><label for="quantity">Estimated quantity *</label><input id="quantity" name="quantity" maxlength="100" required placeholder="e.g. 1,000 pieces" aria-describedby="quantity-help" /><small class="field-help" id="quantity-help" data-quantity-help>An estimate is welcome.</small></div><div class="field"><label for="size">Size / model</label><input id="size" name="size" maxlength="160" placeholder="e.g. P03 or 25 × 30 cm" /></div><div class="field"><label for="destination">Destination country or port *</label><input id="destination" name="destination" maxlength="160" required autocomplete="country-name" /></div><div class="field field-full"><label for="sample">Would you like a sample?</label><select id="sample" name="sample"><option value="">Please select</option><option value="Existing product sample">Existing product sample</option><option value="Custom printed sample">Custom printed sample</option><option value="No sample needed">No sample needed</option></select></div><div class="field field-full"><label for="message" data-message-label>Packaging and printing requirements</label><textarea id="message" name="message" maxlength="5000" aria-describedby="product-help" placeholder="Tell us what you are packing, preferred material, colors, logo printing and required schedule."></textarea></div><div class="field field-full upload-field"><label for="artwork" id="upload-title">Upload logo, reference images or customization brief (optional)</label><label class="upload-dropzone" for="artwork" data-upload-zone><input class="upload-input" id="artwork" name="files" type="file" multiple accept=".png,.jpg,.jpeg,.webp,.pdf,.ai,.psd,.docx,.xlsx,.txt,.csv" data-upload-input aria-labelledby="upload-title" aria-describedby="upload-help upload-status" /><svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m8 12 7-7a4 4 0 0 1 5.7 5.7L10.5 21a6 6 0 0 1-8.5-8.5L12 2.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="m5.5 15.5 9-9a2 2 0 0 1 2.8 2.8l-9 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg><strong>Click to choose files or drag them here</strong><small id="upload-help">PNG, JPG, WEBP, PDF, AI, PSD, DOCX, XLSX, TXT or CSV.<br />Up to 3 files · 10 MB maximum in total.<br />Files are sent with your enquiry.</small></label><p class="upload-status" id="upload-status" data-upload-status role="status" aria-live="polite">No files selected</p><ul class="upload-list" data-upload-list aria-label="Selected files"></ul></div><div class="field field-full"><p class="form-note">By continuing, you agree that Welltroy may use the information provided to respond to your enquiry.</p><p class="form-note" data-submit-hint></p><button class="button" type="submit" disabled>Send My Enquiry</button><p class="form-note">You can also <a href="mailto:info@welltroy.com">email info@welltroy.com</a> or <a href={`https://wa.me/${site.whatsapp}`}>contact us on WhatsApp</a>.</p><div class="form-status" data-form-status role="status" tabindex="-1"></div><div class="enquiry-fallback" data-enquiry-fallback hidden><p>Copy your requirements to send by email or WhatsApp. Attach your files separately when contacting us.</p><div class="button-row"><button type="button" class="service-retry" data-copy-enquiry>Copy enquiry details</button><a class="text-link" href="mailto:info@welltroy.com">Email us ↗</a><a class="text-link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><a class="text-link" href="#quote-form">Check submission status ↑</a></div><p class="form-note" data-copy-status role="status"></p><textarea data-copy-text hidden readonly aria-label="Enquiry details to copy"></textarea></div></div></div></div></form></div></section>
</Layout>
