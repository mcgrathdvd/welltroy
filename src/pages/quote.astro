---
import Layout from "../layouts/Layout.astro";
import { products, site } from "../data.mjs";
import { assistedChoices } from "../quote-options.mjs";
import { orderTerms } from "../ordering.mjs";
---
<Layout title="Request a Packaging Quote | Welltroy" description="Request pricing for Welltroy mailers, bags, pouches, labels and protective packaging. Share the product, quantity, size and destination." canonicalPath="/quote/">
  <section class="page-hero quote-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Request a Quote</div><p class="eyebrow">Packaging enquiry</p><h1>Get a Quote for Your Packaging</h1><p class="lead">Share your product, quantity and destination. We will review the specifications with you and reply by email. You can request samples or include your artwork.</p></div></section>
  <section class="section quote-main"><div class="container quote-layout"><aside><h2>Details That Help</h2><p>A clear specification helps us prepare a more relevant response.</p><ul class="check-list"><li>Product type and intended use</li><li>Catalogue model or custom dimensions</li><li>Estimated order quantity</li><li>Logo or printing requirements</li><li>Destination country or port</li></ul><div class="quote-timing"><strong>Design, samples & payment</strong><span>Free initial design draft within 24 hours after a clear brief.</span><span>{orderTerms.sample}</span><span>Bulk production: {orderTerms.production}</span><span>Payment: {orderTerms.payment}</span><span>Reply to your enquiry: by email. For a time-sensitive request, include your deadline or contact us on WhatsApp.</span><small>Production time excludes shipping. Share your required arrival date and destination.</small><a class="text-link" href="/ordering/">Samples, payment & delivery →</a></div><p><strong>Email</strong><br /><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></p><p><strong>WhatsApp</strong><br /><a class="text-link" href={`https://wa.me/${site.whatsapp}`} rel="noopener">{site.phone}</a></p></aside><form id="quote-form" class="quote-form" data-quote-form action="/api/quote" method="post" enctype="multipart/form-data"><section class="quote-success" data-success hidden aria-labelledby="enquiry-success-title">
  <p class="eyebrow">Enquiry sent</p>
  <h2 id="enquiry-success-title" tabindex="-1">Thank you. We’ll be in touch.</h2>
  <p data-success-summary></p>
  <dl class="success-details">
    <div><dt>Estimated quantity</dt><dd data-success-quantity></dd></div>
    <div><dt>Destination</dt><dd data-success-destination></dd></div>
    <div><dt>Attachments sent</dt><dd data-success-files></dd></div>
  </dl>
  <div class="success-next"><h3>What happens next?</h3><p>We’ll review your specifications and contact you by email to confirm the details for your quotation.</p><p>No need to submit again. To add information, <a data-follow-up href="mailto:info@welltroy.com">email our team</a> and include your enquiry reference.</p></div>
  <details class="success-reference"><summary>View or copy your enquiry reference</summary><p class="form-note">Use this reference when following up with our team.</p><input readonly data-enquiry-reference aria-label="Enquiry reference" /><button type="button" class="service-retry" data-copy-reference>Copy reference</button><p class="form-note" data-reference-status role="status" aria-live="polite"></p></details>
  <div class="button-row"><a class="button" href="/products/">Browse products</a><button class="button button-secondary" type="button" data-new-enquiry>Start a new enquiry</button></div>
</section><div data-form-fields><h2>Your Quote Request</h2><p class="form-note">Fields marked * are required. An enquiry does not place an order or take payment.</p><noscript><p>Please enable JavaScript to submit this form, or email <a href="mailto:info@welltroy.com">info@welltroy.com</a>.</p></noscript><div class="form-trap" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div><div class="form-grid"><div class="field"><label for="name">Name *</label><input id="name" name="name" maxlength="100" required autocomplete="name" /></div><div class="field"><label for="email">Email address *</label><input id="email" name="email" maxlength="254" type="email" required autocomplete="email" /></div><div class="field"><label for="product">Product *</label><select id="product" name="product" required aria-describedby="product-help"><option value="">Select a product or ask for help</option>{assistedChoices.map((choice) => <option value={choice.slug}>{choice.name}</option>)}{products.map((product) => <option value={product.slug}>{product.name}</option>)}</select><small class="field-help" id="product-help" data-product-help>Choose a product, or ask us to help you choose.</small></div><div class="field"><label for="quantity">Estimated quantity *</label><input id="quantity" name="quantity" maxlength="100" required placeholder="e.g. 1,000 pieces" aria-describedby="quantity-help" /><small class="field-help" id="quantity-help" data-quantity-help>An estimate is welcome.</small></div><div class="field"><label for="size">Size / model</label><input id="size" name="size" maxlength="160" placeholder="e.g. P03 or 25 × 30 cm" aria-describedby="size-help" /><small class="field-help" id="size-help" data-size-help role="status" aria-live="polite">Confirm the model or dimensions for the selected product.</small></div><div class="field"><label for="destination">Destination country or port *</label><input id="destination" name="destination" maxlength="160" required autocomplete="country-name" /></div><details class="field field-full enquiry-options"><summary>Company &amp; WhatsApp details (optional)</summary><div class="form-grid"><div class="field"><label for="company">Company</label><input id="company" name="company" maxlength="160" autocomplete="organization" /></div><div class="field"><label for="whatsapp">WhatsApp number</label><input id="whatsapp" name="whatsapp" maxlength="50" type="tel" autocomplete="tel" /></div></div></details><div class="field field-full"><label for="sample">Would you like a sample?</label><select id="sample" name="sample"><option value="">Please select</option><option value="Existing product sample">Existing product sample</option><option value="Custom printed sample">Custom printed sample</option><option value="No sample needed">No sample needed</option></select></div><div class="field field-full"><label for="message" data-message-label>Packaging and printing requirements</label><textarea id="message" name="message" maxlength="5000" aria-describedby="product-help" placeholder="Tell us what you are packing, preferred material, colors, logo printing and required schedule."></textarea></div><div class="field field-full upload-field"><span class="upload-title" id="upload-title">Upload logo, reference images or customization brief (optional)</span><label class="upload-dropzone" for="artwork" data-upload-zone><input class="upload-input" id="artwork" name="files" type="file" multiple accept=".png,.jpg,.jpeg,.webp,.pdf,.ai,.psd,.docx,.xlsx,.txt,.csv" data-upload-input aria-labelledby="upload-title" aria-describedby="upload-help upload-status" /><svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m8 12 7-7a4 4 0 0 1 5.7 5.7L10.5 21a6 6 0 0 1-8.5-8.5L12 2.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="m5.5 15.5 9-9a2 2 0 0 1 2.8 2.8l-9 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg><strong>Click to choose files or drag them here</strong><small id="upload-help">PNG, JPG, WEBP, PDF, AI, PSD, DOCX, XLSX, TXT or CSV.<br />Up to 3 files · 10 MB maximum in total.<br />Files are sent with your enquiry.</small></label><p class="upload-status" id="upload-status" data-upload-status role="status" aria-live="polite">No files selected</p><ul class="upload-list" data-upload-list aria-label="Selected files"></ul></div><div class="field field-full"><div id="quote-verification" class="quote-service" tabindex="-1" data-service-panel data-state="loading"><p class="quote-service-message" data-service-status role="status" aria-live="polite">Checking online enquiry availability…</p><div data-turnstile></div><div class="quote-service-actions" data-service-actions hidden><a class="text-link" href="mailto:info@welltroy.com">Email us ↗</a><a class="text-link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><button type="button" class="service-retry" data-service-retry>Try again</button></div></div><p class="form-note">Your details and files are used to respond to this enquiry. Read our <a href="/privacy/">Privacy Notice</a>.</p><p class="form-note" data-submit-hint></p><button class="service-retry" type="button" data-check-verification>Check security verification ↑</button><button class="button" type="submit" disabled>Send My Enquiry</button><p class="form-note">You can also <a href="mailto:info@welltroy.com">email info@welltroy.com</a> or <a href={`https://wa.me/${site.whatsapp}`}>contact us on WhatsApp</a>.</p><div class="form-status" data-form-status role="status" tabindex="-1"></div><details class="enquiry-fallback" data-enquiry-fallback><summary class="quote-fallback-toggle">Prefer email or WhatsApp? Copy your enquiry</summary><p>Copy your requirements to send by email or WhatsApp. Attach your files separately when contacting us.</p><div class="button-row"><button type="button" class="service-retry" data-copy-enquiry>Copy enquiry details</button><a class="text-link" href="mailto:info@welltroy.com">Email us ↗</a><a class="text-link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><a class="text-link" href="#quote-form">Check submission status ↑</a></div><p class="form-note" data-copy-status role="status"></p><textarea data-copy-text hidden readonly aria-label="Enquiry details to copy"></textarea></details></div></div></div></form></div></section>
</Layout>

<style>
  .upload-title { display:block; font-weight:650; margin-bottom:7px; }
  .quote-success { min-width: 0; overflow-wrap: anywhere; }
  .quote-success h2 { scroll-margin-top: 110px; }
  .success-details { margin: 24px 0; padding: 4px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--cream); }
  .success-details div { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px 0; }
  .success-details div + div { border-top: 1px solid var(--line); }
  .success-details dt { color: var(--muted); font-size: .85rem; }
  .success-details dd { margin: 0; color: var(--ink); font-size: .9rem; font-weight: 600; overflow-wrap: anywhere; }
  .success-next h3 { margin-bottom: 8px; font-size: 1.05rem; }
  .success-next p { font-size: .9rem; line-height: 1.65; }
  .success-next a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .success-reference { margin: 24px 0; padding: 16px 0; border-block: 1px solid var(--line); }
  .success-reference summary { cursor: pointer; color: var(--ink); font-size: .9rem; font-weight: 600; }
  .success-reference input { width: 100%; margin: 4px 0 12px; font-family: ui-monospace, monospace; font-size: .78rem; }
  .success-reference .form-note { margin-bottom: 8px; }
  .success-reference .form-note:empty { display: none; }
</style>
