---
import Layout from '../../layouts/Layout.astro';
import {site} from '../../data.mjs';
import {industryPlans} from '../../industry-plans.mjs';
import {orderTerms,minimumOrder} from '../../ordering.mjs';
import {getProductVisual} from '../../product-images.mjs';
import apparelImage from '../../assets/industries/apparel-mailers.png';
import beautyImage from '../../assets/industries/beauty-bubble-mailers.png';
import paperImage from '../../assets/industries/gifts-paper-bags.png';
import pouchImage from '../../assets/products/stand-up-pouches.png';
import wrapImage from '../../assets/new-products/colored-honeycomb-paper-rolls-wrapping.jpg';
export function getStaticPaths() {
  return industryPlans.map(plan => ({params:{slug:plan.slug},props:{plan}}));
}
const {plan}=Astro.props;
const route=`/industries/${plan.slug}/`;
const quote=`/quote/?product=${plan.productSlug}#quote-form`;
const whatsapp=`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(plan.whatsapp)}`;
const visual=await getProductVisual({apparel:apparelImage,beauty:beautyImage,paper:paperImage,pouch:pouchImage,wrap:wrapImage}[plan.imageKey]);
const published=plan.datePublished || '2026-10-30';
const modified=plan.dateModified || '2026-10-30';
const dateLabel=new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${modified}T00:00:00Z`));
const approvalGuide=plan.approvalGuide || {href:'/guides/custom-mailer-sample-approval/',title:'Use the full sample approval checklist'};
const schema={
  '@context':'https://schema.org','@type':'WebPage','@id':`${site.origin}${route}#webpage`,
  name:plan.title,description:plan.description,url:`${site.origin}${route}`,
  inLanguage:'en',datePublished:published,dateModified:modified,
  author:{'@id':`${site.origin}/#organization`},isPartOf:{'@id':`${site.origin}/#website`}
};
const breadcrumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:`${site.origin}/`},
  {'@type':'ListItem',position:2,name:'Industries',item:`${site.origin}/industries/`},
  {'@type':'ListItem',position:3,name:plan.title,item:`${site.origin}${route}`}
]};
---
<Layout title={plan.seoTitle} description={plan.description} canonicalPath={route} schemas={[schema,breadcrumbs]} quoteProduct={plan.productSlug} contactContext={plan.title} ogImage={visual.imageFull} ogImageAlt={plan.imageAlt}>
  <section class="page-hero"><div class="container industry-plan-hero">
    <div><div class="breadcrumbs"><a href="/">Home</a> / <a href="/industries/">Industries</a> / {plan.title}</div><p class="eyebrow">{plan.eyebrow}</p><h1>{plan.title}</h1><p class="lead">{plan.intro}</p><p class="muted">By <a href="/about/">Welltroy</a> · Updated <time datetime={modified}>{dateLabel}</time></p><div class="button-row"><a class="button" href={quote} data-quote-placement="industry-hero">Discuss This Packaging Project</a><a class="text-link" href={`/products/${plan.productSlug}/`}>View product specifications →</a></div></div>
    <figure><img src={visual.image} srcset={visual.imageSrcSet} sizes="(max-width: 850px) calc(100vw - 40px), 420px" alt={plan.imageAlt} width={visual.imageWidth} height={visual.imageHeight} decoding="async" fetchpriority="high"/><figcaption>{plan.imageNote || 'Packaging illustration · final construction and artwork confirmed by sample.'}</figcaption></figure>
  </div></section>
  <section class="section industry-answer"><div class="container"><h2>{plan.answerQuestion}</h2><p class="lead">{plan.answer}</p><nav class="anchor-links" aria-label="Project planning sections"><a href="#buying-workflow">Buying workflow</a><a href="#packing-route">Choose the pack</a><a href="#version-plan">Plan versions</a><a href="#sample-approval">Approve samples</a><a href="#project-brief">Prepare your brief</a></nav></div></section>
  <section class="section" id="buying-workflow"><div class="container"><h2>{plan.workflowTitle}</h2><p class="lead">{plan.workflowIntro}</p><div class="industry-decision-grid">{plan.workflow.map(row=><article><h3>{row[0]}</h3><p>{row[1]}</p></article>)}</div>{plan.imageKey === "apparel" && <p><a class="text-link" href="/guides/apparel-inner-bags-and-shipping-mailers/">Plan zipper inner bags and shipping mailers together →</a> · <a class="text-link" href="/quote/?product=multiple-products#quote-form" data-quote-placement="industry-plan">Request both packaging layers →</a></p>}</div></section>
  <section class="section section-soft" id="packing-route"><div class="container"><p class="eyebrow">Match the complete order</p><h2>{plan.tableTitle}</h2><p>These are planning routes to review with your actual contents, rather than guaranteed protection or fit recommendations.</p><p class="table-scroll-hint">Swipe the table to compare the packing routes and checks.</p><div class="table-wrap" tabindex="0" role="region" aria-label={plan.tableTitle}><table><thead><tr>{plan.columns.map(column=><th scope="col">{column}</th>)}</tr></thead><tbody>{plan.rows.map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div></div></section>
  <section class="section" id="version-plan"><div class="container"><h2>{plan.versionTitle}</h2><p class="lead">{plan.versionIntro}</p><div class="industry-decision-grid">{plan.versionRows.map(row=><article><h3>{row[0]}</h3><p>{row[1]}</p></article>)}</div><div class="guide-callout"><h3>{plan.exampleTitle}</h3><p>{plan.example}</p></div></div></section>
  <section class="section section-soft" id="sample-approval"><div class="container industry-plan-columns"><div><h2>{plan.approvalTitle}</h2><ol class="industry-approval">{plan.approval.map(check=><li>{check}</li>)}</ol><a class="text-link" href={approvalGuide.href}>{approvalGuide.title} →</a></div><aside class="side-card"><h3>Design, samples and timing</h3><p><strong>Minimum order:</strong> {minimumOrder(plan.productSlug)}. Confirm each size, structure and artwork version in your quotation.</p><p>A free initial design draft is available within 24 hours after a clear brief. Final production artwork requires separate approval.</p><p>{orderTerms.sample}</p><p><strong>Bulk production:</strong> {orderTerms.production}</p><a class="text-link" href="/ordering/">Current ordering and sample terms →</a></aside></div></section>
  <section class="section" id="project-brief"><div class="container industry-plan-columns"><div><p class="eyebrow">Ready for a comparable quotation</p><h2>Prepare Your Project Brief</h2><p>Copy these fields into your enquiry. Leave a specification open when you need help choosing it, and state the destination and arrival deadline.</p><pre class="industry-brief">{plan.brief}</pre><div class="button-row"><a class="button" href={quote} data-quote-placement="industry-plan">Request a Project Quote</a><a class="button button-secondary" href={whatsapp} rel="noopener">Discuss on WhatsApp</a></div></div><aside class="side-card"><h3>Product and source references</h3><p><a class="text-link" href={`/products/${plan.productSlug}/`}>{plan.productName}: options and catalogue dimensions →</a></p>{plan.guides.map(guide=><p><a class="text-link" href={guide.href}>{guide.title} →</a></p>)}<p><a href="/catalogue/">Welltroy catalogue references</a> · <a href="/faq/#buyer-answers">Buyer answers</a></p><p class="muted">Shenzhen Welltroy Technology Co., Ltd. · Shenzhen, China. Confirm the offered specification, minimums and delivery scope in your quotation.</p></aside></div></section>
  <section class="section"><div class="container"><h2>Packing References and Scope</h2>{plan.references.map(reference=><p><a href={reference.href} rel="noopener">{reference.title}</a> — {reference.note}</p>)}</div></section>
  <section class="section section-soft"><div class="container"><h2>Questions About This Project</h2><div class="industry-questions">{plan.faqs.map(faq=><article><h3>{faq.q}</h3><p>{faq.a}</p></article>)}</div></div></section>
</Layout>
<style>
  .industry-plan-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.8fr);gap:48px;align-items:center}
  .industry-plan-hero h1{font-size:clamp(2rem,3.8vw,3.6rem);line-height:1.1;max-width:900px}
  .industry-plan-hero figure{margin:0}.industry-plan-hero img{display:block;width:100%;height:auto;border-radius:20px}
  .industry-plan-hero figcaption{font-size:.78rem;color:var(--muted);margin-top:10px;line-height:1.5}
  .industry-answer .lead{max-width:1000px}.industry-plan-columns{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:48px;align-items:start}
  .industry-decision-grid,.industry-questions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin:28px 0}
  .industry-decision-grid article,.industry-questions article{min-width:0;border:1px solid var(--line);border-radius:16px;padding:24px}
  .industry-decision-grid h3,.industry-questions h3{font-size:1.15rem;line-height:1.4}.industry-approval li{margin-bottom:16px;padding-left:6px}
  .industry-brief{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;font-size:.95rem;line-height:1.9;padding:24px;border:1px solid var(--line);border-radius:14px;background:#f6f7f2}
  table{min-width:680px}th,td{vertical-align:top}th[scope=row]{width:25%}section[id]{scroll-margin-top:110px}
  @media(max-width:850px){.industry-plan-hero,.industry-plan-columns{grid-template-columns:1fr;gap:28px}.industry-plan-hero figure{max-width:520px}.industry-decision-grid,.industry-questions{grid-template-columns:1fr}.industry-plan-hero h1{font-size:2.25rem}.industry-brief{padding:18px}}
</style>
