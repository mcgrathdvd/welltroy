---
import Layout from "../layouts/Layout.astro";
import { site } from "../data.mjs";
import { getProductVisual } from "../product-images.mjs";
import apparelMailers from "../assets/industries/apparel-mailers.png";
import beautyBubbleMailers from "../assets/industries/beauty-bubble-mailers.png";
import giftsPaperBags from "../assets/industries/gifts-paper-bags.png";
import fulfillmentLabels from "../assets/industries/fulfillment-labels.png";
import pouchImage from "../assets/products/stand-up-pouches.png";

const sectors = [
  { id: "apparel", planHref: "/industries/apparel-poly-mailers/", planProduct: "poly-mailers", name: "Apparel & Fashion", imageSource: apparelMailers, imageAlt: "Illustration of orange branded poly mailers for apparel", need: "Separate garment presentation from the outer shipping pack, then size both around the folded item.", decision: "A zipper bag can organize an individual garment, while a poly mailer can be the outer pack for suitable soft goods. A paper bag serves a different job: handing an item to a retail customer. Do not assume an inner zipper bag is a shipping mailer.", checks: ["Measure the garment after folding, including any insert or inner bag; compare usable bag dimensions, not only the flat catalogue size.", "Confirm whether one order contains several garments and whether they must stay separate.", "Check the outer mailer closure and shipping label area with the actual packed order."], products: [{ name: "Poly Mailers", slug: "poly-mailers", use: "Outer shipping for suitable soft goods" }, { name: "Zipper Bags", slug: "zipper-bags", use: "Individual garment organization" }, { name: "Paper & Gift Bags", slug: "paper-gift-bags", use: "Retail handover, not parcel protection" }], guide: { name: "Clothing mailer size guide", href: "/guides/mailer-size-for-clothing/" }, ask: "Share folded garment dimensions, items per order, inner-bag needs, quantities and any artwork." },
  { id: "beauty", planHref: "/industries/beauty-holographic-bubble-mailers/", planProduct: "metallic-bubble-mailers", name: "Beauty & Jewelry", imageSource: beautyBubbleMailers, imageAlt: "Illustration of branded bubble mailers for small boxed products", need: "Start with the packed product's fragility and shape before choosing a protective mailer or presentation bag.", decision: "A bubble mailer may suit a compact boxed item after fit and transit testing. A metallic finish changes the exterior appearance, not the protection requirement. A paper gift bag is for customer presentation and is not a substitute for a shipping pack.", checks: ["State whether the item is glass, liquid, sharp-edged or already boxed; fragile goods may need a rigid box or added protection.", "Ask for usable inner dimensions, bubble construction and seal details for the proposed mailer.", "Test the complete pack for the intended shipping route, including leakage containment where liquids are involved."], products: [{ name: "Poly Bubble Mailers", slug: "poly-bubble-mailers", use: "Cushioned mailer candidate" }, { name: "Metallic Bubble Mailers", slug: "metallic-bubble-mailers", use: "Exterior finish option to test" }, { name: "Paper & Gift Bags", slug: "paper-gift-bags", use: "Customer presentation" }], guide: { name: "Compare kraft and poly bubble mailers", href: "/guides/kraft-vs-poly-bubble-mailers/" }, ask: "Send packed dimensions, weight, fragility, quantity and destination; identify glass or liquid contents." },
  { id: "fulfillment", name: "E-commerce & Fulfillment", imageSource: fulfillmentLabels, imageAlt: "Illustration of thermal shipping label rolls", need: "Specify the repeatable packing workflow, not just an individual package design.", decision: "Group orders by packed size and protection need before selecting mailer sizes. Match thermal labels to the actual printer, roll format and carrier label requirements. Use honeycomb wrap only where a tested packing method calls for separation or surface protection.", checks: ["List common order sizes and daily packing volume so a small set of formats can be compared.", "Provide the printer model, label dimensions, roll core and adhesive requirement; confirm the sales unit before ordering.", "For wrapped items, test the material width, cut length, carton fit and handling time with a real pack."], products: [{ name: "Poly Mailers", slug: "poly-mailers", use: "Repeatable outer-pack sizes" }, { name: "Thermal Labels", slug: "thermal-labels", use: "Printer and carrier compatibility" }, { name: "Honeycomb Paper Rolls", slug: "honeycomb-paper-rolls", use: "Tested wrap and separation" }], guide: { name: "Choose a mailer for each product", href: "/guides/choose-a-mailer/" }, ask: "Include common packed dimensions, order mix, printer model, packing volume and destination." },
  { id: "gifts", planHref: "/industries/homeware-gift-honeycomb-wrap/", planProduct: "honeycomb-paper-rolls", name: "Gifts & Homeware", imageSource: giftsPaperBags, imageAlt: "Illustration of colored branded paper gift bags", need: "Plan the customer handover and the shipping pack as separate use cases.", decision: "A paper carrier bag can present a boxed gift in store; honeycomb paper can wrap or separate surfaces inside a tested pack. Neither establishes transit protection for fragile homeware by itself. Use a box and further cushioning when the actual item and route require them.", checks: ["Measure the gift with its retail box or insert; confirm the bag opening, base depth, handle attachment and loaded carrying sample.", "For bottles, ceramics or sharp corners, test wrapping coverage, movement and the complete shipping carton.", "Approve artwork on the chosen bag paper and finish with a product-specific proof or physical sample."], products: [{ name: "Honeycomb Paper Rolls", slug: "honeycomb-paper-rolls", use: "Wrap and surface separation" }, { name: "Kraft Paper Bags", slug: "kraft-paper-bags", use: "Retail carry format" }, { name: "Paper & Gift Bags", slug: "paper-gift-bags", use: "Presentation and handover" }], guide: { name: "Paper bag size, handles and printing", href: "/guides/custom-paper-bag-size-handles-printing/" }, ask: "Share item and box dimensions, weight, fragility, carrying use, artwork and destination." }
];
sectors.push(
  {id:"retail-events",planHref:"/industries/retail-event-paper-bags/",planProduct:"paper-gift-bags",name:"Retail & Event Paper Bags",imageSource:giftsPaperBags,imageAlt:"Paper bag illustration for retail and event presentation",need:"Choose a carrier bag around the complete purchase or event kit and its handover deadline.",decision:"Compare kraft and gift bags using the same packed dimensions and weight. Natural paper appearance, color and finish are presentation decisions; loaded fit and handle construction need their own approval.",checks:["Measure the complete purchase or gift set, including boxes and tissue; confirm opening, formed base and handle clearance.","Approve paper, handle attachment, any reinforcement and a loaded carrying sample.","List quantities per size and artwork, delivery locations, proof owner and required arrival date."],products:[{name:"Kraft Paper Bags",slug:"kraft-paper-bags",use:"Natural paper presentation to compare"},{name:"Paper & Gift Bags",slug:"paper-gift-bags",use:"Colored retail and event presentation"}],guide:{name:"Paper bag size, handles and printing",href:"/guides/custom-paper-bag-size-handles-printing/"},ask:"Include the boxed item dimensions, maximum carried weight, artwork, version quantities and event or store deadline."},
  {id:"retail-pouches",planHref:"/industries/retail-stand-up-pouches/",planProduct:"stand-up-pouches",name:"Retail Products & Stand-up Pouches",imageSource:pouchImage,imageAlt:"Illustration of several stand-up pouch formats",need:"Connect the contents and retail presentation to an approved filling and sealing process.",decision:"Trial actual fill capacity before fixing a pouch size. Craft or accessory kits and dry food projects require different structure and evidence checks; the same shape does not establish the same suitability.",checks:["Provide contents, fill amount, storage conditions and quantity for each SKU.","Trial opening, headspace, gusset, shelf stance and the initial seal with the filling team.","Confirm the exact structure, offered print route, minimum per version and any destination-market documentation."],products:[{name:"Stand-up Pouches",slug:"stand-up-pouches",use:"Eight catalogue size references"},{name:"Custom Stand Up Pouches",slug:"custom-stand-up-pouches",use:"Made-to-order structure and artwork brief"},{name:"Printed Snack Pouches",slug:"printed-snack-pouches",use:"Food project specification to verify"}],guide:{name:"Stand-up pouch size, structure and artwork",href:"/guides/custom-stand-up-pouch-specification/"},ask:"Include contents, fill amount, filling and sealing method, storage, artwork versions, quantities and required documents."}
);
const sectorVisuals = await Promise.all(sectors.map((sector) => getProductVisual(sector.imageSource)));
sectors.forEach((sector, index) => { sector.visual = sectorVisuals[index]; });
const schema = { "@context": "https://schema.org", "@type": "CollectionPage", name: "Packaging by Industry", url: `${site.origin}/industries/` };
---
<Layout title="Packaging by Industry | Welltroy" description="Compare packaging workflows for apparel, beauty, retail, events, pouches and gift packing. See when to use mailers, inner bags, labels, protective wrap or paper carrier bags, and what to verify before a quote." canonicalPath="/industries/" schemas={[schema]}>
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Industries</div><p class="eyebrow">Packaging by use case</p><h1>Start with the Product You Need to Pack</h1><p class="lead">Different products call for different protection, presentation and packing workflows. Use these examples to narrow the catalogue, then confirm the final specification with your actual product.</p><nav class="anchor-links" aria-label="Industry sections">{sectors.map((sector) => <a href={`#${sector.id}`}>{sector.name} ↗</a>)}</nav></div></section>
  {sectors.map((sector, index) => <section class:list={["section", { "section-soft": index % 2 === 1 }]} id={sector.id}><div class="container industry-layout"><div class="industry-media"><img src={sector.visual.image} srcset={sector.visual.imageSrcSet} sizes="(max-width: 640px) calc(100vw - 28px), (max-width: 980px) calc(100vw - 40px), 500px" alt={sector.imageAlt} loading="lazy" decoding="async" width={sector.visual.imageWidth} height={sector.visual.imageHeight} /><p class="visual-note">Packaging combination illustration · confirm the final product specification</p></div><div><p class="eyebrow">Use case 0{index + 1}</p><h2>{sector.name}</h2><p class="lead">{sector.need}</p><h3>How to choose the pack</h3><p>{sector.decision}</p><h3>Check before ordering</h3><ul class="industry-checks">{sector.checks.map((check) => <li>{check}</li>)}</ul><h3>Relevant products</h3><div class="use-product-list">{sector.products.map((product) => <a href={`/products/${product.slug}/`}><strong>{product.name}</strong><span>{product.use}</span><span aria-hidden="true">↗</span></a>)}</div><p><a class="text-link" href={sector.guide.href}>{sector.guide.name} →</a></p><p class="industry-prompt"><strong>Useful detail for an enquiry:</strong> {sector.ask}</p><div class="button-row">{sector.planHref && <a class="button button-secondary" href={sector.planHref}>View the complete project plan →</a>}<a class="button" href={`/quote/?product=${sector.planProduct || "multiple-products"}#quote-form`}>Discuss this application</a></div></div></div></section>)}
  <section class="cta-band"><div class="container inner"><div><h2>Working Across Several Product Lines?</h2><p>Send a combined list with quantities, product dimensions and destination.</p></div><a class="button button-light" href="/quote/">Request a Quote</a></div></section>
</Layout>
<style>.visual-note{font-size:.78rem;line-height:1.4;color:var(--muted,#5d6761);margin:.6rem 0 0}.industry-checks{padding-left:1.25rem;margin:.5rem 0 1.2rem}.industry-checks li{margin:.35rem 0}h3{font-size:1rem;margin:1.2rem 0 .4rem}</style>

