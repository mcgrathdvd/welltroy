---
import Layout from "../layouts/Layout.astro";
import { site } from "../data.mjs";
import { getProductVisual } from "../product-images.mjs";
import apparelMailers from "../assets/industries/apparel-mailers.png";
import beautyBubbleMailers from "../assets/industries/beauty-bubble-mailers.png";
import giftsPaperBags from "../assets/industries/gifts-paper-bags.png";
import fulfillmentLabels from "../assets/industries/fulfillment-labels.png";

const sectors = [
  { id: "apparel", name: "Apparel & Fashion", imageSource: apparelMailers, imageAlt: "Orange Welltroy-branded poly mailers for apparel shipping", need: "Keep soft goods organized and ready for dispatch without adding unnecessary bulk.", products: [{ name: "Poly Mailers", slug: "poly-mailers", use: "Lightweight outer shipping" }, { name: "Zipper Bags", slug: "zipper-bags", use: "Inner organization and presentation" }, { name: "Paper & Gift Bags", slug: "paper-gift-bags", use: "In-store handover and gifting" }], ask: "Share garment dimensions after folding, pack count and whether each item needs an inner bag." },
  { id: "beauty", name: "Beauty & Jewelry", imageSource: beautyBubbleMailers, imageAlt: "Stack of colored bubble mailers with Welltroy branding on the black mailer", need: "Balance compact protection with a branded arrival experience.", products: [{ name: "Poly Bubble Mailers", slug: "poly-bubble-mailers", use: "Cushioned shipping for small items" }, { name: "Metallic Bubble Mailers", slug: "metallic-bubble-mailers", use: "Distinctive exterior finish" }, { name: "Paper & Gift Bags", slug: "paper-gift-bags", use: "Customer presentation" }], ask: "Tell us whether the product is boxed, glass, liquid or otherwise fragile so the full packing method can be reviewed." },
  { id: "fulfillment", name: "E-commerce & Fulfillment", imageSource: fulfillmentLabels, imageAlt: "Rolls of shipping labels with blue backing and a printed address and barcode example", need: "Make regular packing and labeling easier across a changing mix of orders.", products: [{ name: "Poly Mailers", slug: "poly-mailers", use: "Everyday shipping" }, { name: "Thermal Labels", slug: "thermal-labels", use: "Order and carrier labels" }, { name: "Honeycomb Paper Rolls", slug: "honeycomb-paper-rolls", use: "Wrap and separation" }], ask: "Include your average parcel sizes, printer model and daily packing needs." },
  { id: "gifts", name: "Gifts & Homeware", imageSource: giftsPaperBags, imageAlt: "Welltroy-branded paper gift bags in six colors with ribbon handles", need: "Protect surfaces while keeping unboxing and handover considered.", products: [{ name: "Honeycomb Paper Rolls", slug: "honeycomb-paper-rolls", use: "Wrap and surface protection" }, { name: "Kraft Paper Bags", slug: "kraft-paper-bags", use: "Retail carry format" }, { name: "Stand-up Pouches", slug: "stand-up-pouches", use: "Small product sets" }], ask: "Describe the item's weight, edges and fragility; test the complete pack before production." }
];
const sectorVisuals = await Promise.all(sectors.map((sector) => getProductVisual(sector.imageSource)));
sectors.forEach((sector, index) => { sector.visual = sectorVisuals[index]; });
const schema = { "@context": "https://schema.org", "@type": "CollectionPage", name: "Packaging by Industry", url: `${site.origin}/industries/` };
---
<Layout title="Packaging by Industry | Welltroy" description="Explore packaging combinations for apparel, beauty, fulfillment, gifts and homeware. Compare practical product options and the details needed for a quote." canonicalPath="/industries/" schemas={[schema]}>
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Industries</div><p class="eyebrow">Packaging by use case</p><h1>Start with the Product You Need to Pack</h1><p class="lead">Different products call for different protection, presentation and packing workflows. Use these examples to narrow the catalogue, then confirm the final specification with your actual product.</p><nav class="anchor-links" aria-label="Industry sections">{sectors.map((sector) => <a href={`#${sector.id}`}>{sector.name} ↗</a>)}</nav></div></section>
  {sectors.map((sector, index) => <section class:list={["section", { "section-soft": index % 2 === 1 }]} id={sector.id}><div class="container industry-layout"><div class="industry-media"><img src={sector.visual.image} srcset={sector.visual.imageSrcSet} sizes="(max-width: 640px) calc(100vw - 28px), (max-width: 980px) calc(100vw - 40px), 500px" alt={sector.imageAlt} loading="lazy" decoding="async" width={sector.visual.imageWidth} height={sector.visual.imageHeight} /></div><div><p class="eyebrow">Use case 0{index + 1}</p><h2>{sector.name}</h2><p class="lead">{sector.need}</p><div class="use-product-list">{sector.products.map((product) => <a href={`/products/${product.slug}/`}><strong>{product.name}</strong><span>{product.use}</span><span aria-hidden="true">↗</span></a>)}</div><p class="industry-prompt"><strong>Useful detail for an enquiry:</strong> {sector.ask}</p><a class="button" href="/quote/">Discuss this application</a></div></div></section>)}
  <section class="cta-band"><div class="container inner"><div><h2>Working Across Several Product Lines?</h2><p>Send a combined list with quantities, product dimensions and destination.</p></div><a class="button button-light" href="/quote/">Request a Quote</a></div></section>
</Layout>

