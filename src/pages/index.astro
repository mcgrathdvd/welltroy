---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import Faq from "../components/Faq.astro";
import ProductionPhoto from "../components/ProductionPhoto.astro";
import { products, productGroups, site } from "../data.mjs";
import { reviews } from "../reviews.mjs";
import { catalogue, orderTerms } from "../ordering.mjs";

const homeFaq = [
  { q: "What information do you need to prepare a quotation?", a: "Send the product type, size or packed product dimensions, estimated quantity, printing requirements and destination country. If you are unsure about size, tell us what you plan to pack." },
  { q: "Can I order a custom size?", a: "Custom sizing is available for selected products. Send the required dimensions and quantity so we can confirm feasibility and minimum order requirements." },
  { q: "Can you print our logo?", a: "Logo printing is available for selected products. Options depend on material, artwork, colors and order quantity. Send your artwork for a product-specific recommendation." },
  { q: "What is your minimum order quantity?", a: "Most bag and mailer orders start at 500 pieces. Honeycomb paper starts at 500 rolls; confirm the sales unit for thermal labels with your quotation." },
  { q: "Can I request a sample?", a: orderTerms.sample },
  { q: "Do you ship to Europe, North America and the Middle East?", a: "Send your destination country or port with the enquiry. We will confirm the available shipping arrangement with your quotation." }
];

const organization = {
  "@context": "https://schema.org", "@type": "Organization", "@id": `${site.origin}/#organization`, name: site.name, legalName: site.legalName, url: site.origin,
  logo: `${site.origin}/images/welltroy-logo.svg`,
  email: site.email, telephone: site.phone,
  address: { "@type": "PostalAddress", streetAddress: "4/F Yunsong Bld, Tairan 8th Road, Shatou Street", addressLocality: "Shenzhen", addressRegion: "Guangdong", addressCountry: "CN" }
};
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: homeFaq.slice(0, 3).map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })) };
---
<Layout title="Custom Poly & Bubble Mailers | MOQ 500 | Welltroy" description="Source custom poly, poly bubble and metallic bubble mailers from Welltroy. Eligible orders from 500 pieces, free initial design and sample support." schemas={[organization, faqSchema]}>
  <section class="hero-wide">
    <div class="hero-wide-media"><picture><source media="(max-width: 640px)" srcset="/images/hero-mobile-480.webp 480w, /images/hero-mobile-800.webp 800w" sizes="100vw" /><img src="/images/hero-wide-selected.webp" srcset="/images/hero-wide-1280.webp 1280w, /images/hero-wide-selected.webp 1983w" sizes="100vw" alt="An illustrative arrangement of mailers, pouches, labels, wrap and paper bags" width="1983" height="793" fetchpriority="high" decoding="async" /></picture></div>
    <div class="container hero-wide-inner">
      <p class="hero-wide-eyebrow">Packaging factory · Custom orders from 500 pieces*</p>
      <h1><span>Custom Poly &amp;</span>{" "}<span>Bubble Mailers</span></h1>
      <p class="hero-wide-lead">Custom shipping bags for apparel, beauty and e-commerce brands. Poly, poly bubble and metallic bubble mailers.</p>
      <div class="hero-category-links" aria-label="Popular packaging products">
        <a href="/products/#group-1">Mailers</a>
        <a href="/products/stand-up-pouches/">Pouches</a>
        <a href="/products/kraft-paper-bags/">Paper Bags</a>
        <a href="/products/#group-3">Labels &amp; Wrap</a>
      </div>
      <div class="button-row hero-wide-actions"><a class="button" href="/quote/#quote-form" data-quote-placement="hero">Request a Custom Quote <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="/products/">View Products <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="hero-stats" aria-label="Starting order and sample information">
    <div class="container">
      <div class="hero-stats-grid">
        <div><span>Starting MOQ</span><strong>500+</strong></div>
        <div><span>Design draft</span><strong>24 hours</strong></div>
        <div><span>Sample production</span><strong>From 3 days</strong></div>
        <div><span>Sample delivery target</span><strong>7 days</strong></div>
      </div>
      <p>*500 pieces for eligible bags and mailers; 500 rolls for honeycomb paper. Samples are free. Sample timing starts after specifications and artwork are confirmed; delivery depends on destination. Confirm shipping arrangements and thermal label sales units in your quotation.</p>
    </div>
  </section>


  <section class="section section-soft home-products"><div class="container"><div class="section-head"><div><p class="eyebrow">Product range</p><h2>Explore Our Packaging</h2><p class="lead">Find the format for your goods. Explore sizes and custom options on each product page.</p></div></div><div class="product-grid">{products.slice(0, 6).map((product) => <ProductCard product={product} compactMobile />)}</div><div class="button-row"><a class="button button-secondary" href="/products/">Browse the complete range</a><a class="text-link" href="/catalogue/">Current product guide →</a><a class="text-link" href={catalogue.path} download>Download the 2025 catalogue (PDF) ↓</a></div></div></section>


  <section class="section section-soft" id="industries"><div class="container"><div class="section-head"><div><p class="eyebrow">Use cases</p><h2>Packaging for E-commerce, Retail and Fulfillment</h2><p class="lead">Find a useful product combination for the way your goods are shipped, displayed or handed to customers.</p></div><a class="text-link" href="/industries/">Explore all applications →</a></div><div class="grid-4"><a class="industry-card" href="/industries/#apparel"><h3>Apparel & Fashion</h3><p>Mailer bags, zipper bags and paper bags for garments and accessories.</p><span>Explore use case →</span></a><a class="industry-card" href="/industries/#beauty"><h3>Beauty & Jewelry</h3><p>Compact protective mailers and presentation formats for smaller products.</p><span>Explore use case →</span></a><a class="industry-card" href="/industries/#fulfillment"><h3>E-commerce & Fulfillment</h3><p>Mailers, labels and protective paper for regular packing operations.</p><span>Explore use case →</span></a><a class="industry-card" href="/industries/#gifts"><h3>Gifts & Homeware</h3><p>Paper bags and honeycomb wrap for cushioning and presentation.</p><span>Explore use case →</span></a></div></div></section>

  <section class="section production-feature" id="factory"><div class="container production-overview"><div class="production-copy"><p class="eyebrow">Packaging production</p><h2>A Closer Look at Production</h2><p class="lead">Explore printing, bag making and paper converting equipment. Share your requirements to discuss the process for your packaging.</p><ul class="production-focus"><li><span>01</span><div><strong>Material & dimensions</strong><p>Match the format to what you pack.</p></div></li><li><span>02</span><div><strong>Artwork & color</strong><p>Review branding before production.</p></div></li><li><span>03</span><div><strong>Packing & delivery</strong><p>Confirm the schedule and destination.</p></div></li></ul><a class="button button-light" href="/why-welltroy/#factory-photos">Explore production gallery ↗</a></div><ProductionPhoto image="bag-production" /></div></section>

  <section class="section section-soft"><div class="container guide-teaser"><div><p class="eyebrow">Buying guide</p><h2>Poly Mailer or Bubble Mailer?</h2><p class="lead">Start with product fragility, packed size and the protection needed in transit. Our guide compares four catalogue mailer formats and explains what to measure before requesting pricing.</p><a class="button button-secondary" href="/guides/choose-a-mailer/">Read the mailer guide</a></div><div class="guide-teaser-options"><span>Soft, non-fragile goods <strong>→ Poly mailer</strong></span><span>Compact goods needing cushioning <strong>→ Bubble mailer</strong></span><span>Presentation-led shipment <strong>→ Metallic finish</strong></span><span>Material requirement <strong>→ Request documentation</strong></span></div></div></section>

  <section class="section section-dark"><div class="container"><div class="section-head"><div><p class="eyebrow">How it works</p><h2>From Requirement to Ready-to-Ship Packaging</h2></div></div><div class="process-grid"><article class="step"><span class="step-no">01</span><h3>Share Requirements</h3><p>Product, size, quantity, destination and branding needs.</p></article><article class="step"><span class="step-no">02</span><h3>Confirm Specification</h3><p>Review format, options, quotation and order requirements.</p></article><article class="step"><span class="step-no">03</span><h3>Approve Artwork</h3><p>Confirm artwork and the available sample route.</p></article><article class="step"><span class="step-no">04</span><h3>Production & Delivery</h3><p>Production, inspection, packing and shipment after approval.</p></article></div></div></section>

  <section class="section section-soft"><div class="container"><div class="section-head"><div><p class="eyebrow">Buyer feedback</p><h2>Feedback from Packaging Buyers</h2><p class="lead">Selected buyer comments supplied by Welltroy.</p></div><a class="text-link" href="/reviews/">Buyer reviews →</a></div><div class="review-grid">{reviews.map((review, index) => <details class="review-card review-disclosure" open={index === 0}><summary><span class="review-stars" aria-label="5 out of 5 stars">★★★★★</span><strong>{review.country}</strong><span class="review-toggle">Read buyer review</span></summary><blockquote>“{review.quote}”</blockquote><div class="review-meta"><span>{review.date} · {review.note}</span></div></details>)}</div></div></section>

  <section class="section" id="faq"><div class="container"><div class="section-head"><div><p class="eyebrow">Frequently asked questions</p><h2>Practical Answers Before You Enquire</h2></div><a class="text-link" href="/faq/">See all buyer questions →</a></div><Faq items={homeFaq.slice(0, 3)} /></div></section>
  <section class="cta-band"><div class="container inner"><div><h2>Tell Us What You Need to Pack</h2><p>Send your product, quantity, preferred size and destination for a tailored quotation.</p></div><div class="button-row"><a class="button button-light" href="/quote/#quote-form" data-quote-placement="content">Request a Custom Quote</a><a class="button button-secondary button-light" href={`https://wa.me/${site.whatsapp}`} rel="noopener">WhatsApp</a></div></div></section>
</Layout>

