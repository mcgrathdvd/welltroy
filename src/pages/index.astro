---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import Faq from "../components/Faq.astro";
import ProductionPhoto from "../components/ProductionPhoto.astro";
import { products, productGroups, site } from "../data.mjs";
import { reviews } from "../reviews.mjs";
import { catalogue } from "../ordering.mjs";
import { homeBuyerAnswers } from "../buyer-answers.mjs";

import { getProductVisual } from "../product-images.mjs";
import apparelSource from "../assets/new-products/poly-mailers-apparel-packing.jpg";
import lumiereSource from "../assets/new-products/bubble-mailer-lumiere-case.png";
const [apparelCase, lumiereCase] = await Promise.all([getProductVisual(apparelSource), getProductVisual(lumiereSource)]);
const homeFaq = homeBuyerAnswers;
const coreProducts = ['poly-mailers', 'poly-bubble-mailers', 'zipper-bags'].map(slug => products.find(product => product.slug === slug));

const organization = {
  "@context": "https://schema.org", "@type": "Organization", "@id": `${site.origin}/#organization`, name: site.name, legalName: site.legalName, url: site.origin,
  logo: `${site.origin}/images/welltroy-logo.svg`,
  email: site.email, telephone: site.phone,
  address: { "@type": "PostalAddress", streetAddress: "4/F Yunsong Bld, Tairan 8th Road, Shatou Street", addressLocality: "Shenzhen", addressRegion: "Guangdong", addressCountry: "CN" }
};
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: homeFaq.slice(0, 3).map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })) };
---
<Layout title="Custom Mailers & Garment Zipper Bags | MOQ 500 | Welltroy" description="Source PE poly mailers, poly and kraft bubble mailers, and frosted or clear garment slider bags from Welltroy. Custom logo printing. MOQ 500 pieces." schemas={[organization, faqSchema]}>
  <section class="hero-wide">
    <div class="hero-wide-media"><img src={apparelCase.image} srcset={apparelCase.imageSrcSet} sizes="(max-width: 900px) 100vw, 58vw" alt="A printed poly mailer used to pack folded clothing in a Welltroy apparel project" width={apparelCase.imageWidth} height={apparelCase.imageHeight} fetchpriority="high" decoding="async" /></div>
    <div class="container hero-wide-inner">
      <p class="hero-wide-eyebrow">Packaging factory · MOQ 500 pieces*</p>
      <h1><span>Custom Mailers &amp;</span>{" "}<span>Garment Zipper Bags</span></h1>
      <p class="hero-wide-lead">Pack folded clothing, protect products and prepare e-commerce orders. Choose PE poly mailers, cushioned bubble mailers or frosted and clear garment slider bags.</p>
      <div class="hero-category-links" aria-label="Popular packaging products">
        <a href="/products/poly-mailers/">Poly Mailers</a>
        <a href="/products/poly-bubble-mailers/">Poly Bubble Mailers</a>
        <a href="/products/yellow-kraft-bubble-mailers/">Kraft Bubble Mailers</a>
        <a href="/products/zipper-bags/">Garment Zipper Bags</a>
      </div>
      <div class="button-row hero-wide-actions"><a class="button" href="/quote/#quote-form" data-quote-placement="hero">Request a Custom Quote <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="/products/">View Products <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="hero-stats" aria-label="Starting order and sample information">
    <div class="container">
      <div class="hero-stats-grid">
        <div><span>Core product MOQ</span><strong>500+</strong></div>
        <div><span>Design draft</span><strong>24 hours</strong></div>
        <div><span>Sample production</span><strong>From 3 days</strong></div>
        <div><span>Sample delivery target</span><strong>7 days</strong></div>
      </div>
      <p>*MOQ: 500 pieces for poly mailers, bubble mailers and garment zipper bags. Confirm the quantity breakdown by size, color and design. Other product minimums vary; honeycomb paper starts at 1 roll (1 pc). Samples are free. Sample timing starts after specifications and artwork are confirmed; delivery depends on destination. Confirm shipping arrangements and thermal label sales units in your quotation.</p>
    </div>
  </section>


  <section class="section section-soft home-products"><div class="container"><div class="section-head"><div><p class="eyebrow">Product range</p><h2>Three Packaging Ranges for E-commerce Orders</h2><p class="lead">Choose an outer shipping bag, bubble cushioning or a garment inner bag. Compare materials, usable sizes, closure and logo options before requesting a quote.</p></div></div><div class="product-grid">{coreProducts.map((product) => <ProductCard product={product} compactMobile />)}</div><p>Prefer a paper exterior with bubble cushioning? <a class="text-link" href="/products/yellow-kraft-bubble-mailers/">Explore kraft bubble mailers →</a></p><div class="button-row"><a class="button button-secondary" href="/products/">Browse the complete range</a><a class="text-link" href="#customer-projects">See customer projects ↓</a><a class="text-link" href="/catalogue/">Current product guide →</a><a class="text-link" href={catalogue.path} download>Download the 2025 catalogue (PDF) ↓</a></div></div></section>


  <section class="section home-projects" id="customer-projects" aria-labelledby="customer-projects-heading">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Welltroy customer projects</p><h2 id="customer-projects-heading">See the Mailers Behind the Brief</h2><p class="lead">Explore an apparel packing project and a branded beauty mailer, then plan the specification for your own products.</p></div></div>
      <div class="home-project-grid">
        <article class="home-project-card" aria-labelledby="home-apparel-project">
          <img src={apparelCase.image} srcset={apparelCase.imageSrcSet} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1240px) calc((100vw - 80px) / 2), 570px" width={apparelCase.imageWidth} height={apparelCase.imageHeight} alt="Folded clothing being packed into a pink strawberry-print mailer from an anonymous Welltroy customer project" loading="lazy" decoding="async" />
          <div class="home-project-copy"><p class="eyebrow">Apparel · shared anonymously</p><h3 id="home-apparel-project">Strawberry-Print Poly Mailers</h3><p>A completed apparel project with production and packing photographs. See the printed outer mailer alongside the folded clothing and inner presentation materials.</p><a class="text-link" href="/products/poly-mailers/#poly-mailer-case">View the apparel project →</a></div>
        </article>
        <article class="home-project-card" aria-labelledby="home-lumiere-project">
          <img src={lumiereCase.image} srcset={lumiereCase.imageSrcSet} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1240px) calc((100vw - 80px) / 2), 570px" width={lumiereCase.imageWidth} height={lumiereCase.imageHeight} alt="LUMIÈRE black brand artwork on a matte pink bubble mailer from a Welltroy customer project" loading="lazy" decoding="async" />
          <div class="home-project-copy"><p class="eyebrow">Beauty &amp; jewelry</p><h3 id="home-lumiere-project">LUMIÈRE Branded Bubble Mailers</h3><p>Matte pink film, black brand artwork and bubble cushioning. Review the project brief and the packing details to confirm for a similar branded mailer.</p><a class="text-link" href="/products/poly-bubble-mailers/#lumiere-case">View the LUMIÈRE project →</a></div>
        </article>
      </div>
      <p class="home-project-note">Each project has its own specification. Confirm your material, usable size, artwork and complete packed sample before production.</p>
    </div>
  </section>

  <section class="section section-soft" id="industries"><div class="container"><div class="section-head"><div><p class="eyebrow">Use cases</p><h2>Packaging for E-commerce, Retail and Fulfillment</h2><p class="lead">Find a useful product combination for the way your goods are shipped, displayed or handed to customers.</p></div><a class="text-link" href="/industries/">Explore all applications →</a></div><div class="grid-4"><a class="industry-card" href="/industries/apparel-poly-mailers/"><h3>Apparel & Fashion</h3><p>Mailer bags, zipper bags and paper bags for garments and accessories.</p><span>Explore use case →</span></a><a class="industry-card" href="/industries/beauty-holographic-bubble-mailers/"><h3>Beauty & Jewelry</h3><p>Compact protective mailers and presentation formats for smaller products.</p><span>Explore use case →</span></a><a class="industry-card" href="/industries/#fulfillment"><h3>E-commerce & Fulfillment</h3><p>Mailers, labels and protective paper for regular packing operations.</p><span>Explore use case →</span></a><a class="industry-card" href="/industries/#gifts"><h3>Gifts & Homeware</h3><p>Paper bags and honeycomb wrap for cushioning and presentation.</p><span>Explore use case →</span></a></div></div></section>

  <section class="section production-feature" id="factory"><div class="container production-overview"><div class="production-copy"><p class="eyebrow">Packaging production</p><h2>Custom Packaging, Clearly Specified</h2><p class="lead">Catalogue or custom sizes, branded printing, sample review and written order terms. Explore our production references and the document overview behind your packaging discussion.</p><ul class="production-focus"><li><span>01</span><div><strong>Material & dimensions</strong><p>Match the format to what you pack.</p></div></li><li><span>02</span><div><strong>Artwork & color</strong><p>Review branding before production.</p></div></li><li><span>03</span><div><strong>Packing & delivery</strong><p>Confirm the schedule and destination.</p></div></li></ul><div class="button-row"><a class="button button-light" href="/why-welltroy/#factory-advantages">Explore factory advantages ↗</a><a class="text-link factory-document-link" href="/materials-and-documents/#certificate-references">Certificates &amp; test report references →</a></div></div><ProductionPhoto image="bag-production" /></div></section>

  <section class="section section-soft"><div class="container guide-teaser"><div><p class="eyebrow">Buying guide</p><h2>Poly Mailer or Bubble Mailer?</h2><p class="lead">Start with product fragility, packed size and the protection needed in transit. Our guide compares four catalogue mailer formats and explains what to measure before requesting pricing.</p><a class="button button-secondary" href="/guides/choose-a-mailer/">Read the mailer guide</a></div><div class="guide-teaser-options"><span>Soft, non-fragile goods <strong>→ Poly mailer</strong></span><span>Compact goods needing cushioning <strong>→ Bubble mailer</strong></span><span>Presentation-led shipment <strong>→ Metallic finish</strong></span><span>Material requirement <strong>→ Request documentation</strong></span></div></div></section>

  <section class="section section-dark"><div class="container"><div class="section-head"><div><p class="eyebrow">How it works</p><h2>From Requirement to Ready-to-Ship Packaging</h2></div></div><div class="process-grid"><article class="step"><span class="step-no">01</span><h3>Share Requirements</h3><p>Product, size, quantity, destination and branding needs.</p></article><article class="step"><span class="step-no">02</span><h3>Confirm Specification</h3><p>Review format, options, quotation and order requirements.</p></article><article class="step"><span class="step-no">03</span><h3>Approve Artwork</h3><p>Confirm artwork and the available sample route.</p></article><article class="step"><span class="step-no">04</span><h3>Production & Delivery</h3><p>Production, inspection, packing and shipment after approval.</p></article></div></div></section>

  <section class="section section-soft" id="buyer-reviews"><div class="container"><div class="section-head"><div><p class="eyebrow">Buyer feedback</p><h2>Feedback from Packaging Buyers</h2><p class="lead">Selected buyer comments supplied by Welltroy.</p></div></div><div class="review-grid">{reviews.map((review, index) => <details class="review-card review-disclosure" open={index === 0}><summary><span class="review-stars" aria-label="5 out of 5 stars">★★★★★</span><strong>{review.country}</strong><span class="review-toggle">Read buyer review</span></summary><blockquote>“{review.quote}”</blockquote><div class="review-meta"><span>{review.date} · {review.note}</span></div></details>)}</div></div></section>

  <section class="section" id="faq"><div class="container"><div class="section-head"><div><p class="eyebrow">Frequently asked questions</p><h2>Practical Answers Before You Enquire</h2></div><a class="text-link" href="/faq/">See all buyer questions →</a></div><Faq items={homeFaq.slice(0, 3)} /><p class="home-answer-source">See the <a href="/ordering/">sample and ordering terms</a>, <a href="/guides/logo-artwork-checklist/">design and artwork checklist</a>, and <a href="/faq/#buyer-answers">full custom mailer answers</a> for the details behind these answers.</p></div></section>
  <section class="cta-band"><div class="container inner"><div><h2>Tell Us What You Need to Pack</h2><p>Send your product, quantity, preferred size and destination for a tailored quotation.</p></div><div class="button-row"><a class="button button-light" href="/quote/#quote-form" data-quote-placement="content">Request a Custom Quote</a><a class="button button-secondary button-light" href={`https://wa.me/${site.whatsapp}`} rel="noopener">WhatsApp</a></div></div></section>
</Layout>


<style>.factory-document-link{color:inherit;text-decoration:underline;text-underline-offset:4px}.home-answer-source{max-width:880px;margin:24px auto 0}#buyer-reviews{scroll-margin-top:100px}</style>

<style>
  #customer-projects{scroll-margin-top:100px}.home-project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.home-project-card{min-width:0;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--surface,#fff);display:flex;flex-direction:column}.home-project-card img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;background:#faf8f5}.home-project-copy{padding:24px;display:flex;flex-direction:column;flex:1}.home-project-copy h3{margin:0 0 12px;font-size:1.35rem}.home-project-copy p{margin-top:0}.home-project-copy .text-link{margin-top:auto;padding-top:8px;align-self:flex-start}.home-project-note{max-width:880px;margin:24px 0 0;color:var(--muted);font-size:.9rem}
  @media(max-width:760px){.home-project-grid{grid-template-columns:minmax(0,1fr);gap:24px}.home-project-copy{padding:20px}}
</style>

<style>
  .hero-wide::after { background: linear-gradient(90deg, #153828 0%, #153828 38%, rgba(21,56,40,.9) 46%, rgba(21,56,40,.12) 65%, transparent 80%); }
  .hero-wide-media { left: 42%; }
  .hero-wide-media img { object-position: center 66%; }
  .hero-wide h1 { max-width: 580px; font-size: clamp(2.7rem, 3.8vw, 3.7rem); }
  @media (max-width: 900px) {
    .hero-wide::after { background: rgba(12,35,24,.78); }
    .hero-wide-media { left: 0; opacity: 1; }
    .hero-wide-media img { object-position: center; }
    .hero-wide h1 { font-size: clamp(2rem, 6.8vw, 3.2rem); }
  }
</style>
