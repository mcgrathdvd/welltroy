---
import Layout from "../layouts/Layout.astro";
import ProductionPhoto from "../components/ProductionPhoto.astro";
import { productGroups, catalogueProducts, newProducts, site } from "../data.mjs";
import { catalogue } from "../ordering.mjs";
const organization = { "@context": "https://schema.org", "@type": "Organization", name: site.legalName, url: site.origin, email: site.email, telephone: site.phone, address: { "@type": "PostalAddress", streetAddress: "4/F Yunsong Bld, Tairan 8th Road, Shatou Street", addressLocality: "Shenzhen", addressRegion: "Guangdong", addressCountry: "CN" } };
---
<Layout title="About Welltroy | Packaging Supplier in Shenzhen" description="Learn about Welltroy's packaging range, sourcing approach and contact details for international B2B enquiries." canonicalPath="/about/" schemas={[organization]}>
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / About</div><p class="eyebrow">Welltroy at a glance</p><h1>Packaging Supply for Products on the Move</h1><p class="lead">Shenzhen Welltroy Technology Co., Ltd. helps international buyers compare packaging formats, sizes and custom requirements for shipping, retail and fulfillment.</p></div></section>
  <section class="section"><div class="container about-grid"><div><p class="eyebrow">Our range</p><h2>Catalogue Ranges & New Products</h2><p>Our current catalogue covers poly and bubble mailers, zipper and paper bags, stand-up pouches, thermal labels and honeycomb paper rolls. Alongside the {catalogueProducts.length} catalogue ranges, explore {newProducts.length} newer products on our website. The original ranges include catalogue size tables; newer listings describe their formats and customization options.</p><div class="button-row"><a class="button" href="/products/">Browse products</a><a class="button button-secondary" href={catalogue.path} download>Download 2025 catalogue ↓</a></div></div><div class="about-facts"><div><span>Company</span><strong>{site.legalName}</strong></div><div><span>Location</span><strong>Shenzhen, Guangdong, China</strong></div><div><span>Product groups</span><strong>{productGroups.length} groups · {catalogueProducts.length} catalogue ranges + {newProducts.length} new products</strong></div><div><span>Primary contact</span><a href={`mailto:${site.email}`}>{site.email}</a></div></div></div></section>
  <section class="section section-soft"><div class="container"><div class="section-head"><div><p class="eyebrow">Explore the evidence</p><h2>Review the Range, Production Images and Buyer Feedback</h2><p class="lead">See the product information and photographs behind the conversation before requesting a quotation.</p></div></div><div class="grid-3"><article class="editorial-card"><span class="number">01 / Products</span><h3>2025 product catalogue</h3><p>Browse the original {catalogueProducts.length} packaging ranges and published size tables. The {newProducts.length} newer products are listed separately on our website.</p><a class="text-link" href={catalogue.path} download>Download catalogue (PDF) ↓</a></article><article class="editorial-card"><span class="number">02 / Production</span><h3>Production gallery</h3><p>Explore seven views of production and printing equipment.</p><a class="text-link" href="/why-welltroy/#factory-photos">View production gallery →</a></article><article class="editorial-card"><span class="number">03 / Buyers</span><h3>Buyer feedback</h3><p>Read six selected verified-purchase comments from international buyers.</p><a class="text-link" href="/reviews/">Read buyer reviews →</a></article></div></div></section>
  <section class="section" id="contact"><div class="container production-overview"><div><p class="eyebrow">Contact</p><h2>Talk to Us About Your Packaging</h2><p>We welcome enquiries from buyers in Europe, North America, the Middle East and other markets. Let us know the destination and any local requirements when you contact us.</p><p><strong>Email:</strong> <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a><br /><strong>WhatsApp:</strong> <a class="text-link" href={`https://wa.me/${site.whatsapp}`}>{site.phone}</a><br /><strong>Address:</strong> {site.address}</p><a class="button" href="/quote/">Request a Quote</a></div><ProductionPhoto image="printing-workshop" /></div></section>
</Layout>

